import React, { useState } from "react"
import { useTranslation } from "react-i18next"
import { useNavigate } from "react-router-dom"

export function LandingPage() {
  const { t, i18n } = useTranslation("landing")
  const navigate = useNavigate()
  const [activePersona, setActivePersona] = useState("student")

  const demoText = {
    student: t("demo_student_intro"),
    teacher: t("demo_teacher_intro"),
    parent: t("demo_parent_intro"),
    admin: t("demo_admin_intro"),
  }

  const demoEmojis = { student: "??", teacher: "?????", parent: "????????", admin: "??" }

  return (
    <div style={{ backgroundColor: "#faf7f2", color: "#1e1a14", minHeight: "100vh" }}>
      <nav style={{ backgroundColor: "white", borderBottom: "1px solid #e0d8cb", padding: "16px 40px", display: "flex", justifyContent: "space-between", alignItems: "center" }}>
        <h1 style={{ fontSize: "24px" }}>?? Peripateticware</h1>
        <div style={{ display: "flex", gap: "12px", alignItems: "center" }}>
          <select onChange={(e) => i18n.changeLanguage(e.target.value)} value={i18n.language} style={{ padding: "8px 12px", border: "1px solid #e0d8cb", borderRadius: "8px", backgroundColor: "white", cursor: "pointer" }}>
            <option value="en">English</option>
            <option value="es">Español</option>
            <option value="fr">Français</option>
            <option value="ar">???????</option>
            <option value="ja">???</option>
          </select>
          <button onClick={() => navigate("/login")} style={{ padding: "8px 16px", border: "1px solid #e0d8cb", borderRadius: "12px", cursor: "pointer", backgroundColor: "white" }}>Sign In</button>
        </div>
      </nav>

      <section style={{ padding: "96px 40px" }}>
        <div style={{ maxWidth: "1280px", margin: "0 auto", display: "grid", gridTemplateColumns: "1fr 1fr", gap: "48px", alignItems: "center" }}>
          <div>
            <div style={{ display: "inline-block", backgroundColor: "#eaf2ec", color: "#4a7c59", padding: "8px 16px", borderRadius: "999px", fontSize: "12px", fontWeight: 600, marginBottom: "24px" }}>
              • {t("tagline")}
            </div>
            <h1 style={{ fontSize: "56px", fontWeight: 700, marginBottom: "24px", lineHeight: 1.2 }}>{t("welcome")}</h1>
            <p style={{ fontSize: "18px", color: "#7a6f5e", marginBottom: "32px", lineHeight: 1.6 }}>{t("hero_cta")}</p>

            <div style={{ display: "inline-flex", gap: "4px", padding: "4px", backgroundColor: "#f5f0e6", borderRadius: "999px", border: "1px solid #e0d8cb", marginBottom: "32px" }}>
              {["student", "teacher", "parent", "admin"].map((p) => (
                <button key={p} onClick={() => setActivePersona(p)} style={{ padding: "8px 16px", borderRadius: "999px", fontWeight: 600, border: "none", cursor: "pointer", backgroundColor: activePersona === p ? "#1e1a14" : "transparent", color: activePersona === p ? "white" : "#7a6f5e", transition: "all 0.2s" }}>
                  {p.charAt(0).toUpperCase() + p.slice(1)}
                </button>
              ))}
            </div>

            <p style={{ fontSize: "14px", color: "#7a6f5e", marginBottom: "32px", minHeight: "60px" }}>
              {demoText[activePersona as keyof typeof demoText]}
            </p>

            <div style={{ display: "flex", gap: "12px" }}>
              <button onClick={() => navigate("/login")} style={{ backgroundColor: "#4a7c59", color: "white", padding: "12px 28px", fontWeight: 600, borderRadius: "12px", border: "none", cursor: "pointer" }}>Get Started</button>
              <button style={{ backgroundColor: "white", color: "#1e1a14", padding: "12px 28px", fontWeight: 600, borderRadius: "12px", border: "1px solid #e0d8cb", cursor: "pointer" }}>Learn More</button>
            </div>
          </div>

          <div style={{ fontSize: "80px", textAlign: "center", backgroundColor: "#f5f0e6", borderRadius: "20px", padding: "80px", display: "flex", alignItems: "center", justifyContent: "center", minHeight: "400px", transition: "all 0.3s ease" }}>
            {demoEmojis[activePersona as keyof typeof demoEmojis]}
          </div>
        </div>
      </section>

      <section style={{ padding: "96px 40px", backgroundColor: "#f5f0e6" }}>
        <div style={{ maxWidth: "1280px", margin: "0 auto" }}>
          <h2 style={{ fontSize: "36px", fontWeight: 700, textAlign: "center", marginBottom: "48px" }}>{t("why_section_title")}</h2>
          <div style={{ display: "grid", gridTemplateColumns: "repeat(3, 1fr)", gap: "24px" }}>
            {[1, 2, 3].map((i) => (
              <div key={i} style={{ backgroundColor: "white", padding: "24px", borderRadius: "16px", border: "1px solid #e0d8cb" }}>
                <h3 style={{ fontSize: "18px", fontWeight: 700, marginBottom: "12px" }}>{t(`feature_${i}_title`)}</h3>
                <p style={{ fontSize: "14px", color: "#7a6f5e", lineHeight: 1.6 }}>{t(`feature_${i}_desc`)}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section style={{ padding: "96px 40px" }}>
        <div style={{ maxWidth: "1280px", margin: "0 auto", textAlign: "center" }}>
          <h2 style={{ fontSize: "36px", fontWeight: 700, marginBottom: "48px" }}>{t("privacy_engine_section_title")}</h2>
          <div style={{ display: "grid", gridTemplateColumns: "repeat(3, 1fr)", gap: "24px" }}>
            {["ferpa", "coppa", "gdpr"].map((p) => (
              <div key={p} style={{ backgroundColor: "#ede5d4", padding: "24px", borderRadius: "16px", border: "1px solid #e0d8cb" }}>
                <h4 style={{ fontSize: "16px", fontWeight: 700, marginBottom: "8px" }}>{t(`privacy_${p}_title`)}</h4>
                <p style={{ fontSize: "14px", color: "#7a6f5e", lineHeight: 1.6 }}>{t(`privacy_${p}_desc`)}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <footer style={{ borderTop: "1px solid #e0d8cb", padding: "48px 40px", textAlign: "center", fontSize: "14px", color: "#7a6f5e" }}>
        <p>{t("footer_tagline")}</p>
      </footer>
    </div>
  )
}

export default LandingPage
