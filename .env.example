# ═══════════════════════════════════════════════════════════════════════════
# PERIPATETICWARE ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════════════════════════════
# LOCAL DEVELOPMENT - Ollama on Host
# ═══════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────
# DATABASE CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────
DB_PASSWORD=peripateticware_secure_password_dev
DATABASE_URL=postgresql+asyncpg://peripateticware_user:peripateticware_secure_password_dev@postgres:5432/peripateticware
# ─────────────────────────────────────────────────────────────────────────
# LLM PROVIDER CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────
# Choose: ollama (default), claude
# To switch to Claude: change to 'claude' and set ANTHROPIC_API_KEY
LLM_PROVIDER=ollama

# ─────────────────────────────────────────────────────────────────────────
# OLLAMA CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────
OLLAMA_MODEL_TEXT=mistral
OLLAMA_MODEL_VISION=llava
OLLAMA_TIMEOUT=300

# ─────────────────────────────────────────────────────────────────────────
# CLAUDE API CONFIGURATION (Only if LLM_PROVIDER=claude)
# ─────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=2048

# ─────────────────────────────────────────────────────────────────────────
# SECURITY & AUTHENTICATION
# ─────────────────────────────────────────────────────────────────────────
SECRET_KEY=dev-secret-key-change-in-production
JWT_SECRET=dev-secret-key-change-in-production

# Privacy Engine — student ID anonymisation salt
# Generate a strong random value for production: python -c "import secrets; print(secrets.token_hex(32))"
AUDIT_HASH_SALT=dev-audit-salt-change-in-production

# ─────────────────────────────────────────────────────────────────────────
# CORS & NETWORK
# ─────────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://localhost"]
ALLOWED_HOSTS=["*"]

# ─────────────────────────────────────────────────────────────────────────
# APPLICATION CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
# Set true on a non-development deployment (e.g. a public beta site) that
# still wants the customer-facing demo logins (teacher/student/parent/
# homeschool @example.com, SecurePass123!) to work. Never seeds ADMIN-role
# or @test.local accounts regardless of this flag -- see main.py's lifespan().
ENABLE_DEMO_SEED_ACCOUNTS=false
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost/api
VITE_API_URL=http://localhost:8000/api
NODE_ENV=development

# ─────────────────────────────────────────────────────────────────────────
# AUDIO & MEDIA CONFIGURATION (Phase 7)
# ─────────────────────────────────────────────────────────────────────────
AUDIO_ENABLED=true
AUDIO_MAX_DURATION_SECONDS=30
AUDIO_MAX_FILE_SIZE_MB=5
ASR_ENABLED=false

# ─────────────────────────────────────────────────────────────────────────
# IMAGE CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────
IMAGE_MAX_DIMENSION_PX=1920
IMAGE_JPEG_QUALITY=82
IMAGE_PNG_COMPRESS_LEVEL=7
IMAGE_WEBP_QUALITY=80
IMAGE_MAX_FILE_SIZE_MB=20

# ─────────────────────────────────────────────────────────────────────────
# FEATURE FLAGS
# ─────────────────────────────────────────────────────────────────────────
FIELD_NOTES_ENABLED=true
PEER_PROJECTS_ENABLED=true
DEFAULT_PEER_PROJECT_APPROVAL_MODE=teacher_gate
DEFAULT_MAX_ACTIVE_SELF_PROJECTS=2
# ─────────────────────────────────────────────────────────────────────────
# OLLAMA HOST URL  (Phase 6 addition — explicit Docker host routing)
# ─────────────────────────────────────────────────────────────────────────
# Ollama runs on your Windows host. From inside Docker on Windows the host
# is reachable at host.docker.internal. If running backend bare-metal use
# http://localhost:11434 instead.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ─────────────────────────────────────────────────────────────────────────
# STUDENT FILE UPLOADS  (Phase 6 addition)
# ─────────────────────────────────────────────────────────────────────────
# Development: files saved inside the backend container and served at
# http://localhost:<port>/uploads/<path>
# Production: replace _save_file() in student_activities.py with S3 logic
UPLOAD_DIR=/app/uploads

# ─────────────────────────────────────────────────────────────────────────
# MOBILE APP  (Phase 6 addition — Expo / React Native)
# ─────────────────────────────────────────────────────────────────────────
# Physical device: use your machine's LAN IP, e.g. http://192.168.1.x:8000
# Android emulator: use http://10.0.2.2:8000/api/v1
# iOS simulator: http://localhost:8000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# =============================================================================
# PHASE 5: Privacy Engine & Location Service
# =============================================================================
PRIVACY_CONFIG_DIR=./backend/config/jurisdictions
ACTIVE_JURISDICTION=gdpr_eu
ENABLE_PRIVACY_CHECKS=true
PRIVACY_NOTIFICATION_ENABLED=true
# Enforcement mode for the privacy engine: log | warn | block
# Start in "log" (record only), escalate to "warn", then "block" once dashboards look right.
ENFORCEMENT_MODE=log

# ── Auth / session ────────────────────────────────────────────────────────────
# Access token lifetime in minutes (default 60 = 1h). Frontend silently refreshes.
ACCESS_TOKEN_EXPIRE_MINUTES=60
# After the one-time PII encryption migration, set to true so a wrong/rotated
# FIELD_ENCRYPTION_KEY raises instead of silently serving ciphertext as data.
PII_DECRYPT_STRICT=false

IAPP_CRAWLER_ENABLED=false
IAPP_CRAWLER_SCHEDULE=0 2 * * 0
IAPP_CRAWLER_SOURCES=iapp,gdpr.eu,ico.org.uk

LOCATION_BACKEND=openstreetmap,nominatim,wikidata,wikipedia
GOOGLE_MAPS_API_KEY=
ENABLE_LOCATION_CACHE=true
LOCATION_CACHE_TTL_HOURS=168
LOCATION_ENRICHMENT_ENABLED=true
NOMINATIM_USER_AGENT=Peripateticware/1.0

# =============================================================================
# PHASE 7: Audio, ASR, Student-Initiated Activities
# =============================================================================
AUDIO_ENABLED=true
AUDIO_MAX_DURATION_SECONDS=300
AUDIO_MAX_FILE_SIZE_MB=50
AUDIO_ALLOWED_FORMATS=audio/webm,audio/ogg,audio/mp4

ASR_ENABLED=false
ASSEMBLYAI_API_KEY=

FIELD_NOTES_ENABLED=true
PEER_PROJECTS_ENABLED=true
DEFAULT_PEER_PROJECT_APPROVAL_MODE=teacher_gate

# =============================================================================
# EMAIL / SMTP
# =============================================================================
# In development, leave EMAIL_DRY_RUN=true — emails are logged to console only.
# In production, set EMAIL_DRY_RUN=false and provide real SMTP credentials.
# The app will log a startup WARNING if SMTP_HOST is empty and DRY_RUN is false.
#
# Option A — Gmail (use an App Password, not your account password)
#   Generate at: myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
#
# Option B — SendGrid
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=SG.your-api-key
#
# Option C — Resend (recommended for new projects, generous free tier)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASSWORD=re_your-api-key
EMAIL_FROM=noreply@peripateticware.com
EMAIL_FROM_NAME=Peripateticware
EMAIL_DRY_RUN=true

# =============================================================================
# BETA / SIGNUP GATING
# =============================================================================
# "open"        — anyone can self-signup as TEACHER/PARENT/HOMESCHOOL (today's
#                 behaviour). Students always need a classroom invite regardless.
# "invite_only" — self-signup requires a code in BETA_INVITE_CODES below; the
#                 frontend shows a "Request Beta Access" form instead of the
#                 signup form unless the visitor has a valid ?invite=CODE link.
# Flip this one value to switch modes — no code changes needed either way.
SIGNUP_MODE=open
# Comma-separated invite codes, e.g. "beta-2026-a,beta-2026-b". Share one per
# invited group/person; give someone a link like
#   https://peripateticware.com/signup?invite=beta-2026-a
BETA_INVITE_CODES=

# Where "Request Beta Access" submissions go:
# 1) Appended as a row to a Google Sheet (see docs/BETA_SIGNUP_SETUP.md for the
#    one-time Google Cloud service-account setup — you'll need to create a
#    service account, enable the Sheets API, download its JSON key, and share
#    your sheet with the service account's email address).
GOOGLE_SERVICE_ACCOUNT_FILE=
BETA_SIGNUP_SHEET_ID=
BETA_SIGNUP_SHEET_TAB=Requests
# 2) Emailed to this address (falls back to ADMIN_EMAIL below if unset) using
#    the SMTP credentials configured above — a Gmail App Password works fine.
BETA_NOTIFY_EMAIL=

# =============================================================================
# AI / REGULATION CRAWLER
# =============================================================================
# Set IAPP_CRAWLER_ENABLED=true to allow the privacy/AI regulation crawler.
# Runs on IAPP_CRAWLER_SCHEDULE (cron) and can be triggered manually via
# POST /api/v1/privacy/crawl-regulations
IAPP_CRAWLER_ENABLED=false
IAPP_CRAWLER_SCHEDULE=0 2 * * 0
PRIVACY_AUTO_LOAD=false

# =============================================================================
# SECRETS — ROTATE BEFORE ANY NON-LOCAL DEPLOYMENT
# =============================================================================
# These defaults are intentionally obvious. Change them before going live.
SECRET_KEY=dev-secret-key-change-in-production
AUDIT_HASH_SALT=dev-audit-salt-change-in-production
# =============================================================================
# PLATFORM ADMIN
# =============================================================================
# Email address that receives budget alerts, anomaly reports, and monthly summaries.
# Falls back to EMAIL_FROM if not set.
ADMIN_EMAIL=admin@peripateticware.com

# =============================================================================
# PLATFORM ADMIN SECURITY
# =============================================================================
# Static secret required in X-Platform-Secret header on all /api/v1/platform/* routes.
# Acts as a second auth factor beyond JWT (protects even if a JWT is stolen).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Leave blank in development to disable the check.
PLATFORM_API_SECRET=

# =============================================================================
# API DOCS LOCK (production only — /docs, /redoc, /openapi.json)
# =============================================================================
# In production these routes require HTTP Basic Auth, on top of Cloudflare
# Access already restricting admin.peripateticware.com to the admin email.
# If DOCS_PASSWORD is blank in production, the docs stay disabled (fail closed).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(24))"
DOCS_USERNAME=admin
DOCS_PASSWORD=

# =============================================================================
# PADDLE BILLING
# =============================================================================
# Get from: paddle.com → Developer Tools → Authentication
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# Map Paddle price IDs to internal tier names.
# Format: price_id:tier,price_id:tier
# Find price IDs in Paddle → Catalog → Prices
PADDLE_PRICE_MAP=pri_01xxxstarter:starter,pri_01xxxschool:school,pri_01xxxdistrict:district
# "sandbox" for testing, "production" for live
PADDLE_ENV=sandbox

# =============================================================================
# GITHUB ACTIONS DEPLOY SECRETS (set in GitHub repo → Settings → Secrets)
# =============================================================================
# These are NOT used at runtime — they're here as documentation.
# Add them as GitHub Actions secrets, not in .env:
#
#   DEPLOY_HOST        — your server IP or hostname
#   DEPLOY_USER        — SSH username (e.g. ubuntu, deploy)
#   DEPLOY_SSH_KEY     — private SSH key (full contents of ~/.ssh/id_rsa)
#   DEPLOY_PORT        — SSH port (default: 22)
#   DEPLOY_PATH        — path on server (e.g. /home/ubuntu/peripateticware)
#   DEPLOY_URL         — public URL for smoke test (e.g. https://yourapp.com)

# ── Cloudflare R2 Object Storage ──────────────────────────────────────────
# Leave blank in development (falls back to local /app/uploads/)
# Get these from: Cloudflare Dashboard → R2 → Manage R2 API Tokens
CF_R2_ACCOUNT_ID=
CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_ACCESS_KEY=
CF_R2_BUCKET_NAME=peripateticware-uploads
# Optional: your bucket's public URL (enable via Cloudflare R2 bucket settings)
CF_R2_PUBLIC_URL=

# =============================================================================
# FIELD-LEVEL ENCRYPTION
# =============================================================================
# Fernet key for encrypting PII columns: users.email, users.full_name,
# student_captures.location_lat/lon_enc, notifications.message.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave blank in development (encryption disabled, plaintext stored).
# Set before first production deployment — rotating this key requires re-running:
#   python backend/scripts/encrypt_existing_data.py
FIELD_ENCRYPTION_KEY=
