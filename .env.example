# ═══════════════════════════════════════════════════════════════════════════
# PERIPATETICWARE ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════════════════════════════
# LOCAL DEVELOPMENT - Ollama on Host
# ═══════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────
# DATABASE CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────
DB_PASSWORD=peripateticware_secure_password_dev
DATABASE_URL=postgresql+asyncpg://peripateticware_user:peripateticware_secure_password_dev@postgres:5432/peripateticware
# ─────────────────────────────────────────────────────────────────────────
# LLM PROVIDER CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────
# Choose: ollama (default), claude
# To switch to Claude: change to 'claude' and set ANTHROPIC_API_KEY
LLM_PROVIDER=ollama

# ─────────────────────────────────────────────────────────────────────────
# OLLAMA CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────
OLLAMA_MODEL_TEXT=mistral
OLLAMA_MODEL_VISION=llava
OLLAMA_TIMEOUT=300

# ─────────────────────────────────────────────────────────────────────────
# CLAUDE API CONFIGURATION (Only if LLM_PROVIDER=claude)
# ─────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=2048

# ─────────────────────────────────────────────────────────────────────────
# SECURITY & AUTHENTICATION
# ─────────────────────────────────────────────────────────────────────────
SECRET_KEY=dev-secret-key-change-in-production
JWT_SECRET=dev-secret-key-change-in-production

# Privacy Engine — student ID anonymisation salt
# Generate a strong random value for production: python -c "import secrets; print(secrets.token_hex(32))"
AUDIT_HASH_SALT=dev-audit-salt-change-in-production

# ─────────────────────────────────────────────────────────────────────────
# CORS & NETWORK
# ─────────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://localhost", "*"]
ALLOWED_HOSTS=["*"]

# ─────────────────────────────────────────────────────────────────────────
# APPLICATION CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost/api
VITE_API_URL=http://localhost:8000/api
NODE_ENV=development

# ─────────────────────────────────────────────────────────────────────────
# AUDIO & MEDIA CONFIGURATION (Phase 7)
# ─────────────────────────────────────────────────────────────────────────
AUDIO_ENABLED=true
AUDIO_MAX_DURATION_SECONDS=30
AUDIO_MAX_FILE_SIZE_MB=5
ASR_ENABLED=false

# ─────────────────────────────────────────────────────────────────────────
# IMAGE CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────
IMAGE_MAX_DIMENSION_PX=1920
IMAGE_JPEG_QUALITY=82
IMAGE_PNG_COMPRESS_LEVEL=7
IMAGE_WEBP_QUALITY=80
IMAGE_MAX_FILE_SIZE_MB=20

# ─────────────────────────────────────────────────────────────────────────
# FEATURE FLAGS
# ─────────────────────────────────────────────────────────────────────────
FIELD_NOTES_ENABLED=true
PEER_PROJECTS_ENABLED=true
DEFAULT_PEER_PROJECT_APPROVAL_MODE=teacher_gate
DEFAULT_MAX_ACTIVE_SELF_PROJECTS=2
# ─────────────────────────────────────────────────────────────────────────
# OLLAMA HOST URL  (Phase 6 addition — explicit Docker host routing)
# ─────────────────────────────────────────────────────────────────────────
# Ollama runs on your Windows host. From inside Docker on Windows the host
# is reachable at host.docker.internal. If running backend bare-metal use
# http://localhost:11434 instead.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ─────────────────────────────────────────────────────────────────────────
# STUDENT FILE UPLOADS  (Phase 6 addition)
# ─────────────────────────────────────────────────────────────────────────
# Development: files saved inside the backend container and served at
# http://localhost:<port>/uploads/<path>
# Production: replace _save_file() in student_activities.py with S3 logic
UPLOAD_DIR=/app/uploads

# ─────────────────────────────────────────────────────────────────────────
# MOBILE APP  (Phase 6 addition — Expo / React Native)
# ─────────────────────────────────────────────────────────────────────────
# Physical device: use your machine's LAN IP, e.g. http://192.168.1.x:8000
# Android emulator: use http://10.0.2.2:8000/api/v1
# iOS simulator: http://localhost:8000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# =============================================================================
# PHASE 5: Privacy Engine & Location Service
# =============================================================================
PRIVACY_CONFIG_DIR=./backend/config/jurisdictions
ACTIVE_JURISDICTION=gdpr_eu
ENABLE_PRIVACY_CHECKS=true
PRIVACY_NOTIFICATION_ENABLED=true

IAPP_CRAWLER_ENABLED=false
IAPP_CRAWLER_SCHEDULE=0 2 * * 0
IAPP_CRAWLER_SOURCES=iapp,gdpr.eu,ico.org.uk

LOCATION_BACKEND=openstreetmap,nominatim,wikidata,wikipedia
GOOGLE_MAPS_API_KEY=
ENABLE_LOCATION_CACHE=true
LOCATION_CACHE_TTL_HOURS=168
LOCATION_ENRICHMENT_ENABLED=true
NOMINATIM_USER_AGENT=Peripateticware/1.0

# =============================================================================
# PHASE 7: Audio, ASR, Student-Initiated Activities
# =============================================================================
AUDIO_ENABLED=true
AUDIO_MAX_DURATION_SECONDS=300
AUDIO_MAX_FILE_SIZE_MB=50
AUDIO_ALLOWED_FORMATS=audio/webm,audio/ogg,audio/mp4

ASR_ENABLED=false
ASSEMBLYAI_API_KEY=

FIELD_NOTES_ENABLED=true
PEER_PROJECTS_ENABLED=true
DEFAULT_PEER_PROJECT_APPROVAL_MODE=teacher_gate
