# Copy this file to .env and set your LAN IP.
# Find your IP: macOS/Linux: ifconfig | grep "inet " | grep -v 127.0.0.1
#               Windows:     ipconfig | findstr "IPv4"

EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:8000

# Wayfinding map tiles (WayfindingPanel.tsx). Was tile.openstreetmap.org
# directly -- OSM's shared servers started 403ing ("not following the tile
# usage policy") since that's explicitly against their terms for app
# distribution. Free LocationIQ key, commercial use allowed with
# attribution: https://locationiq.com/pricing
EXPO_PUBLIC_LOCATIONIQ_KEY=your_locationiq_key_here
