{
  "expo": {
    "name": "Peripateticware",
    "slug": "Peripateticware",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "peripateticware",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.peripateticware.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Peripateticware uses your camera to capture field evidence.",
        "NSMicrophoneUsageDescription": "Peripateticware uses your microphone to record field audio.",
        "NSPhotoLibraryUsageDescription": "Peripateticware saves captures to your photo library.",
        "NSLocationWhenInUseUsageDescription": "Peripateticware uses your location to find nearby activities."
      }
    },
    "android": {
      "package": "com.peripateticware.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-location",
      [
        "expo-image-picker",
        {
          "photosPermission": "Peripateticware accesses your photos to add field evidence.",
          "cameraPermission": "Peripateticware uses your camera to capture field evidence."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Peripateticware uses your microphone to record field audio."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "http://192.168.50.40:8000",
      "eas": {
        "projectId": "peripateticware"
      }
    }
  }
}