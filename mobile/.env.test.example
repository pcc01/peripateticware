# ============================================================================
# mobile/.env.test.example
#
# Template for mobile/.env.test — the Detox E2E test credentials file.
#
# mobile/.env.test is gitignored (it holds real test-account passwords) and
# is loaded by e2e/jest.config.js at Detox test startup.
#
# Setup:
#   cp mobile/.env.test.example mobile/.env.test
#   # then fill in real values below
#
# Both test-preflight.ps1 (Android/Windows) and test-preflight-ios.sh
# (iOS/macOS) check for mobile/.env.test before running tests and will
# refuse to proceed on missing/default values.
# ============================================================================

# ── Test account credentials ────────────────────────────────────────────────
# Seeded by the backend's Detox test-seed block in backend/main.py on startup
# (see REGRESSION_LOG.md, Session "No .env.test" fix). Password is shared by
# both seeded accounts.
TEST_STUDENT_EMAIL=student@test.local
TEST_STUDENT_PASSWORD=Test1234!

TEST_TEACHER_EMAIL=teacher@test.local
TEST_TEACHER_PASSWORD=Test1234!

# ── Backend API URL override for E2E builds ─────────────────────────────────
# NOTE: the platform-specific URL is normally baked in at build time by the
# Detox `build` command in .detoxrc.js (10.0.2.2 for the Android emulator,
# localhost for the iOS simulator) — this override exists for cases where the
# preflight/run scripts need to reach the backend directly (health checks)
# or you're running against a non-default backend port/host.
# Android emulator special-cases 10.0.2.2 as the host machine's localhost.
# iOS simulator shares the Mac's network namespace, so localhost works as-is.
TEST_BACKEND_URL=http://localhost:8000
