            </div>
            <div className="card">
              <h3 className="h5 mb-lg">{t("landing:social_skills", "\uD83E\uDD1D Social Skills")}</h3>
              <p className="text-muted">{t("landing:collaborative_field_work_develops_teamwo", "Collaborative field work develops teamwork, communication, and interpersonal skills.")}

              </p>
            </div>
            <div className="card">
              <h3 className="h5 mb-lg">{t("landing:environmental_awareness", "\uD83C\uDF0D Environmental Awareness")}</h3>
              <p className="text-muted">{t("landing:direct_experience_with_nature_fosters_en", "Direct experience with nature fosters environmental stewardship and ecological understanding.")}

              </p>
            </div>
          </div>
        </div>

        {/* CTA */}
        <div style={{ textAlign: 'center' }}>
          <button className="btn btn-primary btn-lg" onClick={() => navigate('/parent')}>{t("landing:view_your_childs_progress", "View Your Child's Progress")}

          </button>
        </div>
      </div>

      <style>{`
        @media (max-width: 768px) {
          .grid-3 { grid-template-columns: 1fr; }
          .grid-2 { grid-template-columns: 1fr; }
        }
      `}</style>
    </div>);

};

export default ParentFeaturesPage;
</file>

<file path="pages/ParentDashboard.module.css">
/* ParentDashboard.module.css - Uses Peripateticware Design System */

.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: var(--section-x);
  background-color: var(--bg);
  min-height: 100vh;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-5xl);
  padding-bottom: var(--space-xl);
  border-bottom: 1px solid var(--border);
}

.header h1 {
  font-family: var(--font-head);
  font-size: var(--font-size-4xl);
  font-weight: 700;
  margin: 0;
  color: var(--text);
}

.refreshBtn {
  padding: var(--space-md) var(--space-lg);
  background-color: var(--primary);
  color: white;
  border: none;
  border-radius: var(--radius-md);
  font-weight: 600;
  cursor: pointer;
  transition: all var(--duration-base) var(--ease-in-out);
  font-size: var(--font-size-base);
}

.refreshBtn:hover:not(:disabled) {
  background-color: var(--primary-deep);
  box-shadow: var(--shadow-card-hover);
}

.refreshBtn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.error {
  background-color: var(--error-muted);
  border: 1px solid var(--error);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  margin-bottom: var(--space-xl);
  color: var(--error);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.error p {
  margin: 0;
  font-weight: 600;
  font-size: var(--font-size-base);
}

.error button {
  background-color: transparent;
  color: var(--error);
  border: 1px solid var(--error);
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius-sm);
  cursor: pointer;
  font-size: var(--font-size-sm);
  transition: all var(--duration-base) var(--ease-in-out);
  font-weight: 600;
}

.error button:hover {
  background-color: var(--error);
  color: white;
}

/* CHILD SELECTOR SECTION */
.childSelector {
  background-color: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: var(--space-2xl);
  box-shadow: var(--shadow-card);
  margin-bottom: var(--space-3xl);
}

.childSelectorLabel {
  font-family: var(--font-head);
  font-size: var(--font-size-xl);
  font-weight: 600;
  margin-bottom: var(--space-md);
  color: var(--text);
}

.childSelectorContent {
  display: flex;
  gap: var(--space-lg);
  align-items: flex-end;
}

.selectorDropdown {
  flex: 1;
  max-width: 400px;
}

.selectorDropdown label {
  display: block;
  font-size: var(--font-size-sm);
  font-weight: 600;
  margin-bottom: var(--space-sm);
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.selectorDropdown select {
  width: 100%;
  padding: var(--space-md);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  background-color: var(--surface);
  color: var(--text);
  font-family: var(--font-body);
  font-size: var(--font-size-base);
  cursor: pointer;
  transition: all var(--duration-base) var(--ease-in-out);
}

.selectorDropdown select:focus {
  outline: none;
  border-color: var(--primary);
  box-shadow: 0 0 0 3px var(--primary-muted);
}

.linkChildBtn {
  padding: var(--space-md) var(--space-lg);
  background-color: var(--primary);
  color: white;
  border: none;
  border-radius: var(--radius-md);
  font-weight: 600;
  font-size: var(--font-size-base);
  cursor: pointer;
  transition: all var(--duration-base) var(--ease-in-out);
}

.linkChildBtn:hover {
  background-color: var(--primary-deep);
  box-shadow: var(--shadow-card-hover);
}

/* PROGRESS SECTION */
.section {
  margin-bottom: var(--space-5xl);
}

.sectionHeader {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-2xl);
  padding-bottom: var(--space-lg);
  border-bottom: 1px solid var(--border);
}

.sectionHeader h2 {
  font-family: var(--font-head);
  font-size: var(--font-size-3xl);
  font-weight: 700;
  margin: 0;
  color: var(--text);
}

.viewAllBtn {
  background-color: transparent;
  color: var(--primary);
  border: 1px solid var(--primary);
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius-md);
  font-weight: 600;
  font-size: var(--font-size-sm);
  cursor: pointer;
  transition: all var(--duration-base) var(--ease-in-out);
}

.viewAllBtn:hover {
  background-color: var(--primary-muted);
  border-color: var(--primary);
}

/* PROGRESS CARD */
.progressCard {
  background-color: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: var(--space-2xl);
  box-shadow: var(--shadow-card);
}

.progressSection {
  margin-bottom: var(--space-2xl);
}

.progressSection:last-child {
  margin-bottom: 0;
}

.label {
  font-weight: 600;
  color: var(--text);
  font-size: var(--font-size-base);
  margin-bottom: var(--space-md);
}

.progressBar {
  width: 100%;
  height: 8px;
  background-color: var(--surface-alt);
  border-radius: var(--radius-full);
  overflow: hidden;
}

.progressFill {
  height: 100%;
  background-color: var(--primary);
  transition: width var(--duration-base) var(--ease-in-out);
}

.percentage {
  font-weight: 700;
  color: var(--primary);
  font-size: var(--font-size-2xl);
  margin-top: var(--space-md);
}

/* COMPETENCIES GRID */
.competenciesGrid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: var(--space-xl);
}

.competencyCard {
  background-color: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  box-shadow: var(--shadow-card);
  transition: all var(--duration-base) var(--ease-in-out);
}

.competencyCard:hover {
  box-shadow: var(--shadow-card-hover);
  transform: translateY(-4px);
}

.competencyCard h3 {
  font-family: var(--font-head);
  font-size: var(--font-size-lg);
  font-weight: 700;
  margin: 0 0 var(--space-md) 0;
  color: var(--text);
}

.competencyLabel {
  font-size: var(--font-size-sm);
  color: var(--text-muted);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: var(--space-sm);
}

.competencyValue {
  font-size: var(--font-size-2xl);
  font-weight: 700;
  color: var(--primary);
}

/* ACTIVITIES GRID */
.activitiesGrid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: var(--space-xl);
}

.activityCard {
  background-color: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  box-shadow: var(--shadow-card);
  cursor: pointer;
  transition: all var(--duration-base) var(--ease-in-out);
}

.activityCard:hover {
  box-shadow: var(--shadow-card-hover);
  transform: translateY(-4px);
}

.activityCard h3 {
  font-family: var(--font-head);
  font-size: var(--font-size-lg);
  font-weight: 700;
  margin: 0 0 var(--space-sm) 0;
  color: var(--text);
}

.description {
  font-size: var(--font-size-sm);
  color: var(--text-muted);
  margin-bottom: var(--space-md);
  line-height: 1.5;
}

.meta {
  display: flex;
  justify-content: space-between;
  font-size: var(--font-size-xs);
  color: var(--text-faint);
  margin-bottom: var(--space-md);
}

.status {
  display: inline-block;
  padding: var(--space-xs) var(--space-sm);
  border-radius: var(--radius-full);
  font-size: var(--font-size-xs);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.status.active {
  background-color: var(--success-muted);
  color: var(--success);
}

.status.completed {
  background-color: var(--surface-alt);
  color: var(--text-muted);
}

.status.pending {
  background-color: var(--warn-muted);
  color: var(--warn);
}

/* EVIDENCE LIST */
.evidenceList {
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
}

.evidenceItem {
  background-color: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  display: flex;
  gap: var(--space-lg);
  align-items: flex-start;
  transition: all var(--duration-base) var(--ease-in-out);
}

.evidenceItem:hover {
  box-shadow: var(--shadow-card-hover);
}

.evidenceType {
  display: inline-block;
  padding: var(--space-sm) var(--space-md);
  background-color: var(--primary-muted);
  color: var(--primary-deep);
  border-radius: var(--radius-md);
  font-size: var(--font-size-xs);
  font-weight: 600;
  text-transform: capitalize;
  white-space: nowrap;
}

.evidenceInfo {
  flex: 1;
}

.evidenceInfo p {
  margin: 0 0 var(--space-xs) 0;
  font-size: var(--font-size-base);
  color: var(--text);
  font-weight: 500;
}

.evidenceInfo small {
  color: var(--text-faint);
  font-size: var(--font-size-xs);
}

/* EMPTY STATE */
.emptyState {
  background-color: var(--surface-alt);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: var(--space-5xl) var(--space-2xl);
  text-align: center;
}

.emptyState p {
  color: var(--text-muted);
  font-size: var(--font-size-base);
  margin: 0;
}

/* LOADING STATE */
.loading {
  background-color: var(--surface);
  border-radius: var(--radius-lg);
  padding: var(--space-5xl) var(--space-2xl);
  text-align: center;
}

.loading p {
  color: var(--text-muted);
  font-size: var(--font-size-base);
  margin: 0;
}

/* LINK CHILD FORM */
.linkChildForm {
  background-color: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: var(--space-2xl);
  box-shadow: var(--shadow-card);
}

.formGroup {
  margin-bottom: var(--space-xl);
}

.formGroup:last-child {
  margin-bottom: 0;
}

.formGroup label {
  display: block;
  font-size: var(--font-size-sm);
  font-weight: 600;
  margin-bottom: var(--space-md);
  color: var(--text);
}

.formGroup input {
  width: 100%;
  padding: var(--space-md);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  background-color: var(--surface);
  color: var(--text);
  font-family: var(--font-body);
  font-size: var(--font-size-base);
  transition: all var(--duration-base) var(--ease-in-out);
}

.formGroup input:focus {
  outline: none;
  border-color: var(--primary);
  box-shadow: 0 0 0 3px var(--primary-muted);
}

.submitBtn {
  width: 100%;
  padding: var(--space-md) var(--space-lg);
  background-color: var(--primary);
  color: white;
  border: none;
  border-radius: var(--radius-md);
  font-weight: 600;
  font-size: var(--font-size-base);
  cursor: pointer;
  transition: all var(--duration-base) var(--ease-in-out);
  font-family: var(--font-body);
}

.submitBtn:hover {
  background-color: var(--primary-deep);
  box-shadow: var(--shadow-card-hover);
}

.submitBtn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* RESPONSIVE */
@media (max-width: 768px) {
  .container {
    padding: var(--space-lg);
  }

  .header {
    flex-direction: column;
    gap: var(--space-lg);
    align-items: flex-start;
  }

  .header h1 {
    font-size: var(--font-size-3xl);
  }

  .childSelectorContent {
    flex-direction: column;
    align-items: stretch;
  }

  .selectorDropdown {
    max-width: 100%;
  }

  .competenciesGrid,
  .activitiesGrid {
    grid-template-columns: 1fr;
  }

  .sectionHeader h2 {
    font-size: var(--font-size-2xl);
  }
    .settingsBtn {
      padding: var(--space-md) var(--space-lg);
      background-color: transparent;
      color: var(--primary);
      border: 1px solid var(--primary);
      border-radius: var(--radius-md);
      font-weight: 600;
      cursor: pointer;
      transition: all var(--duration-base) var(--ease-in-out);
      font-size: var(--font-size-base);
    }
  
    .settingsBtn:hover {
      background-color: var(--primary-muted);
      box-shadow: var(--shadow-card-hover);
    }
  
    .navGrid,
    .adminNav {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: var(--space-lg);
      margin-top: var(--space-xl);
    }
  
    .navCard {
      padding: var(--space-xl);
      background-color: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      font-weight: 600;
      cursor: pointer;
      transition: all var(--duration-base) var(--ease-in-out);
      text-align: center;
      font-size: var(--font-size-base);
      color: var(--text);
    }
  
    .navCard:hover {
      box-shadow: var(--shadow-card-hover);
      transform: translateY(-4px);
      background-color: var(--primary-muted);
      border-color: var(--primary); }
}
</file>

<file path="pages/ParentDashboard.tsx">
import { useTranslation } from 'react-i18next';
// Copyright (c) 2026 Paul Christopher Cerda
// This source code is licensed under the Business Source License 1.1
// found in the LICENSE.md file in the root directory of this source tree.

/**
 * Parent Dashboard - Fully Wired with Zustand Stores & API Services
 * Displays: Linked Children, Child Progress, Child Activities
 */

import React, { useEffect, useState } from 'react';
import { useNavigate } from 'react-router-dom';
import { useParentStore } from '@/stores';
import styles from './ParentDashboard.module.css';
import { useAuthStore } from '@/stores/auth';

export const ParentDashboard: React.FC = () => {
  const navigate = useNavigate();
  const [linkChildEmail, setLinkChildEmail] = useState('');

  const {
    dashboardData,
    selectedChildId,
    loading,
    error,
    fetchDashboard,
    fetchLinkedChildren,
    fetchChildProgress,
    linkChild,
    selectChild,
    clearError
  } = useParentStore();

  const { logout } = useAuthStore();

  const handleLogout = () => {
    logout();
    navigate('/');
  };
  // Extract data safely from dashboardData
  const linkedChildren = dashboardData?.linkedChildren || [];
  const childProgress = dashboardData?.childProgress || {};

  // Load data on mount
  useEffect(() => {
    const loadData = async () => {
      try {
        await Promise.all([fetchDashboard(), fetchLinkedChildren()]);
      } catch (err) {
        console.error('Failed to load dashboard:', err);
      }
    };

    loadData();
  }, []);

  // Load child progress when child is selected
  useEffect(() => {
    if (selectedChildId) {
      fetchChildProgress(selectedChildId);
    }
  }, [selectedChildId]);

  // Handle refresh
  const handleRefresh = async () => {
    try {
      await Promise.all([fetchDashboard(), fetchLinkedChildren()]);
      if (selectedChildId) {
        await fetchChildProgress(selectedChildId);
      }
    } catch (err) {
      console.error('Refresh failed:', err);
    }
  };

  // Handle link child
  const handleLinkChild = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!linkChildEmail) return;

    try {
      await linkChild(linkChildEmail);
      setLinkChildEmail('');
      // Select the newly linked child
      const updated = await useParentStore.getState().linkedChildren;
      if (updated.length > 0) {
        selectChild(updated[updated.length - 1].id);
      }
    } catch (err) {
      console.error('Failed to link child:', err);
    }
  };

  if (loading && !dashboardData) {
    return (
      <div className={styles.container}>
        <div className={styles.loading}>
          <p>{t("landing:loading_dashboard", "Loading dashboard...")}</p>
        </div>
      </div>);

  }

  return (
    <div className={styles.container}>
      {/* Header */}
      <div className={styles.header}>
        <h1>{t("landing:parent_dashboard", "Parent Dashboard")}</h1>
        <button onClick={handleRefresh} className={styles.refreshBtn} disabled={loading}>
          {loading ? 'Refreshing...' : 'Refresh'}
        </button>
      </div>
      
      <button
        onClick={handleLogout}
        className={styles.logoutBtn}
        title={t("landing:parentdashboard.logout", "Logout")}>{t("landing:parentdashboard.logout", "\uD83D\uDEAA Logout")}


      </button>
      {/* Error Message */}
      {error &&
      <div className={styles.error}>
          <p>{error}</p>
          <button onClick={clearError}>{t("landing:dismiss", "Dismiss")}</button>
        </div>
      }

      {/* Link Child Section */}
      <section className={styles.linkChildSection}>
        <h2>{t("landing:link_your_child", "Link Your Child")}</h2>
        <form onSubmit={handleLinkChild} className={styles.linkForm}>
          <input
            type="email"
            placeholder={t("landing:enter_your_childs_email_address", "Enter your child's email address")}
            value={linkChildEmail}
            onChange={(e) => setLinkChildEmail(e.target.value)}
            disabled={loading} />
          
          <button type="submit" disabled={loading || !linkChildEmail}>
            {loading ? 'Linking...' : 'Link Child'}
          </button>
        </form>
        <p className={styles.note}>{t("landing:well_send_a_verification_request_to_your", "We'll send a verification request to your child's email address.")}

        </p>
      </section>

      {/* Linked Children */}
      {linkedChildren.length === 0 ?
      <div className={styles.emptyState}>
          <p>{t("landing:no_children_linked_yet_link_your_child_a", "No children linked yet. Link your child above to get started!")}</p>
        </div> :

      <>
          {/* Children Selector */}
          <section className={styles.childrenSelector}>
            <h2>{t("landing:your_children", "Your Children (")}{linkedChildren.length})</h2>
            <div className={styles.childrenList}>
              {linkedChildren.map((child) =>
            <button
              key={child.id}
              className={`${styles.childButton} ${
              selectedChildId === child.id ? styles.selected : ''}`
              }
              onClick={() => selectChild(child.id)}
              disabled={!child.verified}>
              
                  <div className={styles.childName}>{child.full_name}</div>
                  <div className={styles.childGrade}>{t("landing:parentdashboard.grade", "Grade")}{child.grade_level}</div>
                  {!child.verified && <span className={styles.pending}>{t("landing:pending", "Pending")}</span>}
                </button>
            )}
            </div>
          </section>
            {/* Navigation Quick Links */}
            <section className={styles.section}>
              <h2>{t("landing:quick_links", "Quick Links")}</h2>
              <div className={styles.navGrid}>
                <button
              onClick={() => navigate('/parent/progress')}
              className={styles.navCard}>{t("landing:parentdashboard.progress_reports", "\uD83D\uDCCA Progress Reports")}


            </button>
                <button
              onClick={() => navigate('/parent/messages')}
              className={styles.navCard}>{t("landing:messages", "\uD83D\uDCAC Messages")}


            </button>
                <button
              onClick={() => navigate('/parent/calendar')}
              className={styles.navCard}>{t("landing:calendar", "\uD83D\uDCC5 Calendar")}


            </button>
                <button
              onClick={() => navigate('/parent/reports')}
              className={styles.navCard}>{t("landing:reports", "\uD83D\uDCCB Reports")}


            </button>
                <button
              onClick={() => navigate('/parent/notifications')}
              className={styles.navCard}>{t("landing:parentdashboard.notifications", "\uD83D\uDD14 Notifications")}


            </button>
                <button
              onClick={() => navigate('/parent/settings')}
              className={styles.navCard}>{t("landing:parentdashboard.settings", "\u2699\uFE0F Settings")}


            </button>
              </div>
            </section>
            <button
          onClick={() => navigate('/parent/settings')}
          className={styles.settingsBtn}
          title={t("landing:parentdashboard.settings", "Settings")}>{t("landing:parentdashboard.settings", "\u2699\uFE0F Settings")}


        </button>
          {/* Selected Child Progress */}
          {selectedChildId && childProgress &&
        <>
              {/* Overall Stats */}
              <section className={styles.statsSection}>
                <div className={styles.childHeader}>
                  <h2>{childProgress.student_name}{t("landing:progress_overview", "- Progress Overview")}</h2>
                </div>

                <div className={styles.progressCard}>
                  <div className={styles.progressItem}>
                    <div className={styles.label}>{t("landing:overall_progress", "Overall Progress")}</div>
                    <div className={styles.progressBar}>
                      <div
                    className={styles.progressFill}
                    style={{ width: `${childProgress.overall_progress}%` }} />
                  
                    </div>
                    <div className={styles.percentage}>{childProgress.overall_progress}%</div>
                  </div>
                </div>

                {/* Competencies */}
                {childProgress.competencies && childProgress.competencies.length > 0 &&
            <div className={styles.competenciesSection}>
                    <h3>{t("landing:competencies", "Competencies")}</h3>
                    <div className={styles.competenciesList}>
                      {childProgress.competencies.map((comp) =>
                <div key={comp.competency_id} className={styles.competencyItem}>
                          <div className={styles.competencyName}>{comp.competency_name}</div>
                          <div className={styles.competencyStatus}>{comp.status}</div>
                          <div className={styles.progressBar}>
                            <div
                      className={styles.progressFill}
                      style={{ width: `${comp.progress}%` }} />
                    
                          </div>
                          <div className={styles.percentage}>{comp.progress}%</div>
                        </div>
                )}
                    </div>
                  </div>
            }
              </section>

              {/* Activities */}
              {childProgress.activities && childProgress.activities.length > 0 &&
          <section className={styles.section}>
                  <h3>{t("landing:current_activities", "Current Activities (")}{childProgress.activities.length})</h3>
                  <div className={styles.activitiesList}>
                    {childProgress.activities.map((activity) =>
              <div key={activity.id} className={styles.activityCard}>
                        <h4>{activity.title}</h4>
                        <p className={styles.description}>{activity.description}</p>
                        <div className={styles.meta}>
                          <span>{activity.subject}</span>
                          <span>{activity.location}</span>
                        </div>
                        <div className={styles.dueDate}>{t("landing:due", "Due:")}
                  {new Date(activity.due_date).toLocaleDateString()}
                        </div>
                      </div>
              )}
                  </div>
                </section>
          }

              {/* Recent Evidence */}
              {childProgress.recent_evidence && childProgress.recent_evidence.length > 0 &&
          <section className={styles.section}>
                  <h3>{t("landing:recent_evidence", "Recent Evidence (")}{childProgress.recent_evidence.length})</h3>
                  <div className={styles.evidenceList}>
                    {childProgress.recent_evidence.slice(0, 5).map((evidence) =>
              <div key={evidence.id} className={styles.evidenceItem}>
                        <div className={styles.evidenceType}>{evidence.capture_type}</div>
                        <div className={styles.evidenceInfo}>
                          <p>{evidence.description || 'No description'}</p>
                          <small>{new Date(evidence.created_at).toLocaleDateString()}</small>
                        </div>
                      </div>
              )}
                  </div>
                </section>
          }
            </>
        }
        </>
      }
    </div>);

};

export default ParentDashboard;
</file>

<file path="pages/ParentFeaturesPage.css">
/* Parent Features Page */

:root {
  --bg: #faf7f2;
  --surface: #ffffff;
  --surface-alt: #f5f0e6;
  --border: #e0d8cb;
  --text: #1e1a14;
  --text-muted: #7a6f5e;
  --accent: #4a7c59;
  --accent-deep: #2d5037;
  --warn: #c87941;
}

.pfp-page {
  background-color: var(--bg);
  color: var(--text);
  min-height: 100vh;
}

.pfp-container {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 40px;
}

/* NAV */
.pfp-nav {
  background-color: white;
  border-bottom: 1px solid var(--border);
  padding: 16px 40px;
  position: sticky;
  top: 0;
  z-index: 50;
}

.pfp-nav-container {
  max-width: 1280px;
  margin: 0 auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.pfp-logo {
  font-size: 24px;
  font-weight: 700;
  margin: 0;
}

.pfp-nav-button {
  padding: 8px 16px;
  border: 1px solid var(--border);
  border-radius: 8px;
  background-color: white;
  cursor: pointer;
  font-size: 14px;
  font-weight: 600;
  transition: all 0.2s;
}

.pfp-nav-button:hover {
  background-color: var(--surface-alt);
}

/* HERO */
.pfp-hero {
  padding: 96px 40px;
  background-color: var(--bg);
}

.pfp-hero-content {
  display: flex;
  flex-direction: column;
  gap: 16px;
  max-width: 600px;
}

.pfp-tagline {
  display: inline-block;
  background-color: #eaf2ec;
  color: var(--accent);
  padding: 8px 16px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 600;
  width: fit-content;
}

.pfp-headline {
  font-size: 48px;
  font-weight: 700;
  margin: 0;
  line-height: 1.2;
}

.pfp-intro {
  font-size: 18px;
  color: var(--text-muted);
  margin: 0;
  line-height: 1.6;
}

.pfp-btn-primary {
  padding: 12px 32px;
  background-color: var(--accent);
  color: white;
  border: none;
  border-radius: 12px;
  font-weight: 600;
  cursor: pointer;
  font-size: 14px;
  transition: all 0.2s;
  width: fit-content;
  margin-top: 8px;
}

.pfp-btn-primary:hover {
  background-color: var(--accent-deep);
}

/* PHONE MOCKUP */
.pfp-hero-visual {
  position: absolute;
  right: 40px;
  top: 200px;
  width: 340px;
}

.pfp-phone-mockup {
  aspect-ratio: 9 / 19;
  border-radius: 32px;
  padding: 12px;
  box-shadow: 0 28px 60px rgba(30, 26, 20, 0.30);
  border: 1px solid var(--border);
  background: white;
}

.pfp-phone-inner {
  width: 100%;
  height: 100%;
  background-color: white;
  border-radius: 26px;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border: 1px solid var(--border);
}

.pfp-phone-header {
  height: 32px;
  background-color: var(--surface-alt);
  border-bottom: 1px solid var(--border);
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 0 12px;
  font-size: 11px;
  font-weight: 600;
}

.pfp-phone-content {
  flex: 1;
  padding: 16px 12px;
  overflow: hidden;
}

.pfp-phone-digest-card {
  background: var(--surface-alt);
  border-radius: 12px;
  padding: 12px;
  border: 1px solid var(--border);
}

.pfp-digest-header {
  font-size: 9px;
  font-weight: 600;
  color: var(--text-muted);
  margin-bottom: 8px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.pfp-digest-item {
  display: flex;
  gap: 10px;
  margin-bottom: 10px;
  align-items: center;
}

.pfp-digest-emoji {
  font-size: 20px;
  flex-shrink: 0;
}

.pfp-digest-title {
  font-size: 10px;
  font-weight: 600;
  color: var(--text);
}

.pfp-digest-meta {
  font-size: 8px;
  color: var(--text-muted);
  margin-top: 2px;
}

/* SECTIONS */
.pfp-section-title {
  font-size: 36px;
  font-weight: 700;
  margin: 0 0 12px 0;
  text-align: center;
}

/* FEATURES SECTION */
.pfp-features {
  padding: 96px 40px;
  background-color: var(--surface-alt);
}

.pfp-feature-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
  margin-top: 48px;
}

.pfp-feature-card {
  background-color: white;
  padding: 32px 24px;
  border-radius: 16px;
  border: 1px solid var(--border);
}

.pfp-feature-icon {
  font-size: 40px;
  margin-bottom: 12px;
}

.pfp-feature-card h3 {
  font-size: 18px;
  font-weight: 700;
  margin: 0 0 12px 0;
}

.pfp-feature-card p {
  font-size: 14px;
  color: var(--text-muted);
  line-height: 1.6;
  margin: 0 0 16px 0;
}

.pfp-feature-list {
  list-style: none;
  padding: 0;
  margin: 0;
  font-size: 13px;
  line-height: 1.8;
  color: var(--text-muted);
}

/* HOW IT WORKS */
.pfp-how-it-works {
  padding: 96px 40px;
  background-color: var(--bg);
}

.pfp-steps {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
  margin-top: 48px;
}

.pfp-step {
  background-color: white;
  padding: 32px 24px;
  border-radius: 16px;
  border: 1px solid var(--border);
  text-align: center;
}

.pfp-step-number {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
  background-color: var(--accent);
  color: white;
  border-radius: 50%;
  font-weight: 700;
  font-size: 20px;
  margin: 0 auto 16px;
}

.pfp-step h3 {
  font-size: 16px;
  font-weight: 700;
  margin: 0 0 8px 0;
}

.pfp-step p {
  font-size: 13px;
  color: var(--text-muted);
  line-height: 1.6;
  margin: 0;
}

/* PRIVACY SECTION */
.pfp-privacy {
  padding: 96px 40px;
  background-color: var(--surface-alt);
}

.pfp-privacy-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
  margin-top: 48px;
}

.pfp-privacy-card {
  background-color: white;
  padding: 24px;
  border-radius: 16px;
  border: 1px solid var(--border);
  text-align: center;
}

.pfp-privacy-icon {
  font-size: 40px;
  margin-bottom: 12px;
}

.pfp-privacy-card h3 {
  font-size: 16px;
  font-weight: 700;
  margin: 0 0 8px 0;
}

.pfp-privacy-card p {
  font-size: 13px;
  color: var(--text-muted);
  line-height: 1.6;
  margin: 0;
}

/* CTA SECTION */
.pfp-cta {
  padding: 96px 40px;
  background-color: var(--bg);
  text-align: center;
}

.pfp-cta h2 {
  font-size: 36px;
  font-weight: 700;
  margin: 0 0 12px 0;
}

.pfp-cta p {
  font-size: 18px;
  color: var(--text-muted);
  margin: 0 0 32px 0;
}

/* FOOTER */
.pfp-footer {
  padding: 48px 40px;
  border-top: 1px solid var(--border);
  background-color: var(--surface-alt);
  text-align: center;
}

.pfp-footer p {
  font-size: 13px;
  color: var(--text-muted);
  margin: 0;
}

/* RESPONSIVE */
@media (max-width: 768px) {
  .pfp-hero-visual {
    position: static;
    width: 100%;
    margin-top: 40px;
  }

  .pfp-feature-grid,
  .pfp-steps,
  .pfp-privacy-grid {
    grid-template-columns: 1fr;
  }

  .pfp-headline {
    font-size: 32px;
  }

  .pfp-section-title {
    font-size: 24px;
  }
}
</file>

