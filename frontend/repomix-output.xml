// Copyright (c) 2026 Paul Christopher Cerda
// This source code is licensed under the Business Source License 1.1
// found in the LICENSE.md file in the root directory of this source tree.

import { create } from 'zustand'

interface UIStore {
  // Mobile menu
  isMobileMenuOpen: boolean
  toggleMobileMenu: () => void
  closeMobileMenu: () => void

  // Dark mode
  isDarkMode: boolean
  toggleDarkMode: () => void
  setDarkMode: (isDark: boolean) => void

  // Notifications
  notifications: Array<{
    id: string
    type: 'success' | 'error' | 'warning' | 'info'
    message: string
    duration?: number
  }>
  addNotification: (notification: Omit<UIStore['notifications'][0], 'id'>) => void
  removeNotification: (id: string) => void

  // Modals
  openModals: Record<string, boolean>
  openModal: (modalId: string) => void
  closeModal: (modalId: string) => void
}

export const useUIStore = create<UIStore>((set) => ({
  // Mobile menu
  isMobileMenuOpen: false,
  toggleMobileMenu: () =>
    set((state) => ({
      isMobileMenuOpen: !state.isMobileMenuOpen,
    })),
  closeMobileMenu: () => set({ isMobileMenuOpen: false }),

  // Dark mode
  isDarkMode: localStorage.getItem('dark-mode') === 'true',
  toggleDarkMode: () =>
    set((state) => {
      const newValue = !state.isDarkMode
      localStorage.setItem('dark-mode', String(newValue))
      if (newValue) {
        document.documentElement.classList.add('dark')
      } else {
        document.documentElement.classList.remove('dark')
      }
      return { isDarkMode: newValue }
    }),
  setDarkMode: (isDark) => {
    localStorage.setItem('dark-mode', String(isDark))
    if (isDark) {
      document.documentElement.classList.add('dark')
    } else {
      document.documentElement.classList.remove('dark')
    }
    set({ isDarkMode: isDark })
  },

  // Notifications
  notifications: [],
  addNotification: (notification) =>
    set((state) => ({
      notifications: [
        ...state.notifications,
        {
          ...notification,
          id: Math.random().toString(36).substr(2, 9),
        },
      ],
    })),
  removeNotification: (id) =>
    set((state) => ({
      notifications: state.notifications.filter((n) => n.id !== id),
    })),

  // Modals
  openModals: {},
  openModal: (modalId) =>
    set((state) => ({
      openModals: {
        ...state.openModals,
        [modalId]: true,
      },
    })),
  closeModal: (modalId) =>
    set((state) => ({
      openModals: {
        ...state.openModals,
        [modalId]: false,
      },
    })),
}))
</file>

<file path="src/styles/design-system.css">
/* ============================================================================
   PERIPATETICWARE DESIGN SYSTEM - COMPLETE
   
   Color Palettes:
   - Field Guide: Green (#4a7c59) + Warm Beige (#faf7f2)
   - Terrain: Orange (#d4a574) + Light Beige (#f5f0e6)
   - Atmosphere: Purple (#a89dd5) + Dark (#141c17)
   
   Typography:
   - Headers: Lora (serif)
   - Body: DM Sans (sans-serif)
   - Code: DM Mono (monospace)
   
   ============================================================================ */

@import url('https://fonts.googleapis.com/css2?family=Lora:wght@400;600;700&family=DM+Sans:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap');
@import url('https://fonts.googleapis.com/css2?family=Noto+Sans+Arabic:wght@400;600;700&family=Noto+Sans+JP:wght@400;600;700&display=swap');

/* ============================================================================
   ROOT VARIABLES
   ============================================================================ */

:root {
  /* FIELD GUIDE (GREEN) - Default */
  --bg: #faf7f2;
  --surface: #ffffff;
  --surface-alt: #f5f0e6;
  --surface-deep: #ede5d4;
  
  --border: #e0d8cb;
  --border-strong: #c9bfaa;
  --border-light: #f0ede5;
  
  --text: #1e1a14;
  --text-muted: #7a6f5e;
  --text-faint: #a89d8a;
  
  /* Primary accent - changes by direction */
  --primary: #4a7c59;        /* Field Guide Green */
  --primary-light: #6a9c79;
  --primary-deep: #2d5037;
  --primary-muted: #eaf2ec;
  
  /* Secondary accent */
  --secondary: #8b6f47;      /* Brown */
  --secondary-light: #a98860;
  --secondary-muted: #f3ede3;
  
  /* Semantic colors */
  --success: #4a7c59;
  --success-muted: #eaf2ec;
  --warn: #c87941;
  --warn-muted: #f8ece0;
  --error: #d64545;
  --error-muted: #f8e4e4;
  --info: #4a9ef0;
  --info-muted: #e8f4ff;

  /* Fonts */
  --font-head: 'Lora', Georgia, serif;
  --font-body: 'DM Sans', system-ui, -apple-system, sans-serif;
  --font-mono: 'DM Mono', 'Courier New', monospace;
  --font-ar: 'Noto Sans Arabic', sans-serif;
  --font-ja: 'Noto Sans JP', sans-serif;

  /* Border Radius */
  --radius-xs: 4px;
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 16px;
  --radius-xl: 20px;
  --radius-full: 999px;

  /* Shadows */
  --shadow-xs: 0 1px 2px rgba(30, 26, 20, 0.04);
  --shadow-sm: 0 2px 8px rgba(30, 26, 20, 0.06);
  --shadow-md: 0 4px 12px rgba(30, 26, 20, 0.08);
  --shadow-card: 0 2px 16px rgba(30, 26, 20, 0.06);
  --shadow-card-hover: 0 12px 32px rgba(30, 26, 20, 0.10);
  --shadow-pop: 0 16px 48px rgba(30, 26, 20, 0.14);

  /* Spacing */
  --space-xs: 4px;
  --space-sm: 8px;
  --space-md: 12px;
  --space-lg: 16px;
  --space-xl: 24px;
  --space-2xl: 32px;
  --space-3xl: 48px;
  --space-4xl: 64px;
  --space-5xl: 96px;

  /* Typography */
  --font-size-xs: 12px;
  --font-size-sm: 14px;
  --font-size-base: 16px;
  --font-size-lg: 18px;
  --font-size-xl: 20px;
  --font-size-2xl: 24px;
  --font-size-3xl: 32px;
  --font-size-4xl: 40px;

  /* Transitions */
  --duration-fast: 150ms;
  --duration-base: 250ms;
  --duration-slow: 350ms;
  --ease-in-out: cubic-bezier(0.4, 0, 0.2, 1);

  /* Layout */
  --section-y: 96px;
  --section-x: clamp(20px, 5vw, 80px);
  --max-width: 1200px;
}

/* ============================================================================
   DESIGN DIRECTION OVERRIDES
   ============================================================================ */

/* TERRAIN (Orange Palette) */
body[data-direction="terrain"] {
  --primary: #d4a574;         /* Orange */
  --primary-light: #e4b584;
  --primary-deep: #b38a57;
  --primary-muted: #faf6f0;
  --secondary: #5bc4a0;       /* Teal */
  --bg: #f5f0e6;
  --surface-alt: #f0e8dc;
}

/* ATMOSPHERE (Dark Palette) */
body[data-direction="atmosphere"] {
  --primary: #a89dd5;         /* Purple */
  --primary-light: #b8aee2;
  --primary-deep: #9088c5;
  --primary-muted: #f0ece8;
  --secondary: #4a9ef0;       /* Blue */
  --bg: #141c17;
  --surface: #1a2320;
  --surface-alt: #232b28;
  --surface-deep: #2c3530;
  --border: #3a4541;
  --text: #f5f5f5;
  --text-muted: #b0b0b0;
  --text-faint: #808080;
}

/* RTL Support (Arabic) */
html[dir="rtl"],
html[lang="ar"] {
  direction: rtl;
  text-align: right;
}

html[dir="rtl"] input,
html[dir="rtl"] textarea {
  text-align: right;
}

/* ============================================================================
   RESET & BASE STYLES
   ============================================================================ */

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

*::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

*::-webkit-scrollbar-track {
  background: var(--surface-alt);
}

*::-webkit-scrollbar-thumb {
  background: var(--border);
  border-radius: var(--radius-full);
}

*::-webkit-scrollbar-thumb:hover {
  background: var(--border-strong);
}

html,
body,
#root {
  width: 100%;
  height: 100%;
  font-family: var(--font-body);
  color: var(--text);
  background-color: var(--bg);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* Language-specific fonts */
html[lang="ar"],
[lang="ar"] {
  font-family: var(--font-ar), var(--font-body);
}

html[lang="ja"],
[lang="ja"] {
  font-family: var(--font-ja), var(--font-body);
}

/* ============================================================================
   TYPOGRAPHY
   ============================================================================ */

h1, .h1 {
  font-family: var(--font-head);
  font-size: var(--font-size-4xl);
  font-weight: 700;
  line-height: 1.1;
  color: var(--text);
}

h2, .h2 {
  font-family: var(--font-head);
  font-size: var(--font-size-3xl);
  font-weight: 700;
  line-height: 1.2;
  color: var(--text);
}

h3, .h3 {
  font-family: var(--font-head);
  font-size: var(--font-size-2xl);
  font-weight: 700;
  line-height: 1.3;
  color: var(--text);
}

h4, .h4 {
  font-family: var(--font-head);
  font-size: var(--font-size-xl);
  font-weight: 600;
  line-height: 1.3;
  color: var(--text);
}

h5, .h5 {
  font-family: var(--font-head);
  font-size: var(--font-size-lg);
  font-weight: 600;
  line-height: 1.4;
  color: var(--text);
}

h6, .h6 {
  font-family: var(--font-head);
  font-size: var(--font-size-base);
  font-weight: 600;
  line-height: 1.5;
  color: var(--text);
}

p {
  margin-bottom: var(--space-md);
}

.text-base {
  font-size: var(--font-size-base);
  color: var(--text);
}

.text-sm {
  font-size: var(--font-size-sm);
  color: var(--text);
}

.text-xs {
  font-size: var(--font-size-xs);
  color: var(--text);
}

.text-lg {
  font-size: var(--font-size-lg);
  color: var(--text);
}

.text-muted {
  color: var(--text-muted);
}

.text-faint {
  color: var(--text-faint);
}

.text-primary {
  color: var(--primary);
}

.text-secondary {
  color: var(--secondary);
}

.text-success {
  color: var(--success);
}

.text-warn {
  color: var(--warn);
}

.text-error {
  color: var(--error);
}

.text-info {
  color: var(--info);
}

.font-weight-400 {
  font-weight: 400;
}

.font-weight-500 {
  font-weight: 500;
}

.font-weight-600 {
  font-weight: 600;
}

.font-weight-700 {
  font-weight: 700;
}

a {
  color: var(--primary);
  text-decoration: none;
  transition: color var(--duration-base) var(--ease-in-out);
}

a:hover {
  color: var(--primary-deep);
  text-decoration: underline;
}

code {
  font-family: var(--font-mono);
  background-color: var(--surface-alt);
  padding: var(--space-xs) var(--space-sm);
  border-radius: var(--radius-sm);
  font-size: var(--font-size-sm);
  color: var(--primary);
}

/* ============================================================================
   BUTTONS
   ============================================================================ */

button,
.btn {
  font-family: var(--font-body);
  font-size: var(--font-size-base);
  font-weight: 600;
  cursor: pointer;
  border: none;
  border-radius: var(--radius-md);
  padding: var(--space-md) var(--space-lg);
  transition: all var(--duration-base) var(--ease-in-out);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-md);
  white-space: nowrap;
}

/* Primary Button */
.btn-primary,
button[type="submit"] {
  background-color: var(--primary);
  color: white;
  box-shadow: var(--shadow-sm);
}

.btn-primary:hover,
button[type="submit"]:hover {
  background-color: var(--primary-deep);
  box-shadow: var(--shadow-card-hover);
}

.btn-primary:active {
  transform: scale(0.98);
}

.btn-primary:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* Secondary Button */
.btn-secondary {
  background-color: var(--surface);
  color: var(--text);
  border: 1px solid var(--border);
}

.btn-secondary:hover {
  background-color: var(--surface-alt);
  border-color: var(--border-strong);
  box-shadow: var(--shadow-sm);
}

/* Tertiary Button */
.btn-tertiary {
  background-color: transparent;
  color: var(--primary);
  border: 1px solid var(--primary);
}

.btn-tertiary:hover {
  background-color: var(--primary-muted);
}

/* Text Button */
.btn-text {
  background-color: transparent;
  color: var(--primary);
  padding: 0;
}

.btn-text:hover {
  color: var(--primary-deep);
}

/* Danger Button */
.btn-danger {
  background-color: var(--error);
  color: white;
}

.btn-danger:hover {
  background-color: #c53e3e;
}

/* Success Button */
.btn-success {
  background-color: var(--success);
  color: white;
}

.btn-success:hover {
  background-color: var(--primary-deep);
}

/* Small Button */
.btn-sm {
  padding: var(--space-sm) var(--space-md);
  font-size: var(--font-size-sm);
}

/* Large Button */
.btn-lg {
  padding: var(--space-lg) var(--space-xl);
  font-size: var(--font-size-lg);
}

/* Full Width Button */
.btn-block {
  width: 100%;
}

/* ============================================================================
   CARDS & CONTAINERS
   ============================================================================ */

.card,
.card-base {
  background-color: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: var(--space-xl);
  box-shadow: var(--shadow-card);
  transition: all var(--duration-base) var(--ease-in-out);
}

.card:hover {
  box-shadow: var(--shadow-card-hover);
}

.card-compact {
  padding: var(--space-lg);
}

.card-flat {
  background-color: var(--surface-alt);
  border: none;
  box-shadow: none;
}

.card-bordered {
  border: 2px solid var(--border-strong);
}

.card-accent {
  border-left: 4px solid var(--primary);
}

.card-section {
  padding-bottom: var(--section-y);
  margin-bottom: var(--section-y);
}

.container {
  width: 100%;
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0 var(--section-x);
}

.container-sm {
  max-width: 800px;
}

.container-lg {
  max-width: 1400px;
}

/* ============================================================================
   FORMS
   ============================================================================ */

input,
textarea,
select,
.form-control {
  font-family: var(--font-body);
  font-size: var(--font-size-base);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: var(--space-md) var(--space-lg);
  color: var(--text);
  background-color: var(--surface);
  transition: all var(--duration-base) var(--ease-in-out);
  width: 100%;
}

input::placeholder,
textarea::placeholder {
  color: var(--text-faint);
}

input:focus,
textarea:focus,
select:focus {
  outline: none;
  border-color: var(--primary);
  box-shadow: 0 0 0 3px var(--primary-muted);
}

input:disabled,
textarea:disabled,
select:disabled {
  background-color: var(--surface-alt);
  color: var(--text-muted);
  cursor: not-allowed;
}

textarea {
  resize: vertical;
  min-height: 120px;
}

.form-group {
  margin-bottom: var(--space-xl);
}

.form-group label {
  display: block;
  font-weight: 600;
  margin-bottom: var(--space-sm);
  color: var(--text);
}

.form-group .help-text {
  font-size: var(--font-size-sm);
  color: var(--text-muted);
  margin-top: var(--space-sm);
}

.form-group .error-text {
  font-size: var(--font-size-sm);
  color: var(--error);
  margin-top: var(--space-sm);
}

.form-error input,
.form-error textarea,
.form-error select {
  border-color: var(--error);
  box-shadow: 0 0 0 3px rgba(214, 69, 69, 0.1);
}

/* ============================================================================
   BADGES & TAGS
   ============================================================================ */

.badge,
.tag {
  display: inline-flex;
  align-items: center;
  gap: var(--space-xs);
  padding: var(--space-xs) var(--space-sm);
  border-radius: var(--radius-full);
  font-size: var(--font-size-sm);
  font-weight: 600;
  white-space: nowrap;
}

.badge-primary {
  background-color: var(--primary-muted);
  color: var(--primary-deep);
}

.badge-secondary {
  background-color: var(--secondary-muted);
  color: var(--secondary);
}

.badge-success {
  background-color: var(--success-muted);
  color: var(--success);
}

.badge-warn {
  background-color: var(--warn-muted);
  color: var(--warn);
}

.badge-error {
  background-color: var(--error-muted);
  color: var(--error);
}

.badge-outline {
  border: 1px solid var(--border);
  background-color: transparent;
  color: var(--text);
}

/* ============================================================================
   MODALS & OVERLAYS
   ============================================================================ */

.modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(30, 26, 20, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background-color: var(--surface);
  border-radius: var(--radius-xl);
  padding: var(--space-2xl);
  max-width: 500px;
  width: 90%;
  box-shadow: var(--shadow-pop);
}

.modal-header {
  margin-bottom: var(--space-xl);
  border-bottom: 1px solid var(--border);
  padding-bottom: var(--space-lg);
}

.modal-header h2 {
  margin: 0;
}

.modal-footer {
  margin-top: var(--space-xl);
  padding-top: var(--space-lg);
  border-top: 1px solid var(--border);
  display: flex;
  gap: var(--space-lg);
  justify-content: flex-end;
}

/* ============================================================================
   GRID & FLEXBOX
   ============================================================================ */

.grid {
  display: grid;
  gap: var(--space-xl);
}

.grid-2 {
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
}

.grid-3 {
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
}

.grid-4 {
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
}

.flex {
  display: flex;
}

.flex-col {
  flex-direction: column;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.gap-sm {
  gap: var(--space-sm);
}

.gap-md {
  gap: var(--space-md);
}

.gap-lg {
  gap: var(--space-lg);
}

.gap-xl {
  gap: var(--space-xl);
}

/* ============================================================================
   SPACING
   ============================================================================ */

.p-xs { padding: var(--space-xs); }
.p-sm { padding: var(--space-sm); }
.p-md { padding: var(--space-md); }
.p-lg { padding: var(--space-lg); }
.p-xl { padding: var(--space-xl); }
.p-2xl { padding: var(--space-2xl); }

.px-xs { padding-left: var(--space-xs); padding-right: var(--space-xs); }
.px-sm { padding-left: var(--space-sm); padding-right: var(--space-sm); }
.px-md { padding-left: var(--space-md); padding-right: var(--space-md); }
.px-lg { padding-left: var(--space-lg); padding-right: var(--space-lg); }
.px-xl { padding-left: var(--space-xl); padding-right: var(--space-xl); }

.py-xs { padding-top: var(--space-xs); padding-bottom: var(--space-xs); }
.py-sm { padding-top: var(--space-sm); padding-bottom: var(--space-sm); }
.py-md { padding-top: var(--space-md); padding-bottom: var(--space-md); }
.py-lg { padding-top: var(--space-lg); padding-bottom: var(--space-lg); }
.py-xl { padding-top: var(--space-xl); padding-bottom: var(--space-xl); }

.m-xs { margin: var(--space-xs); }
.m-sm { margin: var(--space-sm); }
.m-md { margin: var(--space-md); }
.m-lg { margin: var(--space-lg); }
.m-xl { margin: var(--space-xl); }

.mx-auto { margin-left: auto; margin-right: auto; }
.my-auto { margin-top: auto; margin-bottom: auto; }

/* ============================================================================
   UTILITIES
   ============================================================================ */

.bg {
  background-color: var(--bg);
}

.bg-surface {
  background-color: var(--surface);
}

.bg-surface-alt {
  background-color: var(--surface-alt);
}

.bg-primary {
  background-color: var(--primary);
  color: white;
}

.bg-secondary {
  background-color: var(--secondary);
  color: white;
}

.border {
  border: 1px solid var(--border);
}

.border-top {
  border-top: 1px solid var(--border);
}

.border-bottom {
  border-bottom: 1px solid var(--border);
}

.rounded {
  border-radius: var(--radius-md);
}

.rounded-lg {
  border-radius: var(--radius-lg);
}

.rounded-xl {
  border-radius: var(--radius-xl);
}

.rounded-full {
  border-radius: var(--radius-full);
}

.shadow {
  box-shadow: var(--shadow-card);
}

.shadow-lg {
  box-shadow: var(--shadow-card-hover);
}

.shadow-pop {
  box-shadow: var(--shadow-pop);
}

.opacity-50 {
  opacity: 0.5;
}

.opacity-75 {
  opacity: 0.75;
}

.hidden {
  display: none;
}

.visible {
  visibility: visible;
}

.overflow-hidden {
  overflow: hidden;
}

.cursor-pointer {
  cursor: pointer;
}

/* ============================================================================
   RESPONSIVE
   ============================================================================ */

@media (max-width: 768px) {
  h1, .h1 {
    font-size: var(--font-size-3xl);
  }

  h2, .h2 {
    font-size: var(--font-size-2xl);
  }

  h3, .h3 {
    font-size: var(--font-size-xl);
  }

  .grid-2,
  .grid-3,
  .grid-4 {
    grid-template-columns: 1fr;
  }

  .modal-content {
    width: 95%;
    padding: var(--space-xl);
  }
}

@media (max-width: 480px) {
  :root {
    --space-xl: 16px;
    --space-2xl: 24px;
    --space-3xl: 32px;
  }

  h1, .h1 {
    font-size: var(--font-size-2xl);
  }

  .card,
  .card-base {
    padding: var(--space-lg);
  }

  input,
  textarea,
  select,
  .form-control {
    padding: var(--space-md) var(--space-md);
  }

  .modal-footer {
    flex-direction: column;
  }

  .modal-footer .btn {
    width: 100%;
  }
}

/* ============================================================================
   ANIMATIONS
   ============================================================================ */

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes slideUp {
  from {
    transform: translateY(20px);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

@keyframes slideDown {
  from {
    transform: translateY(-20px);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

@keyframes slideIn {
  from {
    transform: translateX(-20px);
    opacity: 0;
  }
  to {
    transform: translateX(0);
    opacity: 1;
  }
}

.animate-fadeIn {
  animation: fadeIn var(--duration-base) var(--ease-in-out);
}

.animate-slideUp {
  animation: slideUp var(--duration-base) var(--ease-in-out);
}

.animate-slideDown {
  animation: slideDown var(--duration-base) var(--ease-in-out);
}

.animate-slideIn {
  animation: slideIn var(--duration-base) var(--ease-in-out);
}
</file>

<file path="src/styles/globals.css">
/* Global styles - Peripateticware Hi-Fi Design System */

@import url('https://fonts.googleapis.com/css2?family=Lora:wght@400;600;700&family=DM+Sans:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap');

:root {
  /* Colors - Hi-Fi Design System */
  --bg: #faf7f2;
  --surface: #ffffff;
  --surface-alt: #f5f0e6;
  --surface-deep: #ede5d4;
  --border: #e0d8cb;
  --border-strong: #c9bfaa;
  --text: #1e1a14;
  --text-muted: #7a6f5e;
  --text-faint: #a89d8a;
  --accent: #4a7c59;
  --accent-deep: #2d5037;
  --accent-text: #ffffff;
  --accent-muted: #eaf2ec;
  --warn: #c87941;
  --warn-muted: #f8ece0;

  /* Fonts */
  --font-head: 'Lora', Georgia, serif;
  --font-body: 'DM Sans', system-ui, sans-serif;
  --font-mono: 'DM Mono', monospace;

  /* Radius */
  --radius-card: 16px;
  --radius-card-lg: 20px;
  --radius-btn: 12px;
  --radius-pill: 999px;

  /* Shadows */
  --shadow-card: 0 2px 16px rgba(30, 26, 20, 0.06);
  --shadow-card-hover: 0 12px 32px rgba(30, 26, 20, 0.10);
  --shadow-pop: 0 16px 48px rgba(30, 26, 20, 0.14);

  /* Spacing */
  --section-y: 96px;
  --section-x: clamp(20px, 5vw, 80px);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html,
body {
  font-family: var(--font-body);
  color: var(--text);
  background-color: var(--bg);
  line-height: 1.6;
}

h1, h2, h3, h4, h5, h6 {
  font-family: var(--font-head);
  font-weight: 700;
  line-height: 1.2;
}

button {
  font-family: var(--font-body);
  cursor: pointer;
  border: none;
  border-radius: var(--radius-btn);
  transition: all 0.2s ease;
}

.btn-primary {
  background-color: var(--accent);
  color: var(--accent-text);
  padding: 12px 28px;
  font-weight: 600;
}

.btn-primary:hover {
  background-color: var(--accent-deep);
  box-shadow: var(--shadow-card-hover);
}

.btn-secondary {
  background-color: var(--surface);
  color: var(--text);
  border: 1px solid var(--border);
  padding: 12px 28px;
  font-weight: 600;
}

.btn-secondary:hover {
  background-color: var(--surface-alt);
  border-color: var(--border-strong);
}

.card {
  background-color: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-card);
  padding: 24px;
  box-shadow: var(--shadow-card);
  transition: all 0.2s ease;
}

.card:hover {
  box-shadow: var(--shadow-card-hover);
}

input,
textarea,
select {
  font-family: var(--font-body);
  border: 1px solid var(--border);
  border-radius: var(--radius-btn);
  padding: 10px 14px;
  color: var(--text);
  background-color: var(--surface);
}

input:focus,
textarea:focus,
select:focus {
  outline: none;
  border-color: var(--accent);
  box-shadow: 0 0 0 3px var(--accent-muted);
}

.text-muted {
  color: var(--text-muted);
}

.text-faint {
  color: var(--text-faint);
}

.bg-surface {
  background-color: var(--surface);
}

.bg-surface-alt {
  background-color: var(--surface-alt);
}

.border {
  border-color: var(--border);
}

.text-center {
  text-align: center;
}
</file>

<file path="src/styles/landing.css">
/* ============================================================================
   LANDING PAGE - COMPLETE STYLING
   Peripateticware Hi-Fi Design System
   ============================================================================ */

/* ============================================================================
   TYPOGRAPHY
   ============================================================================ */

.h-display {
  font-family: var(--font-head);
  font-size: 3.5rem;
  line-height: 1.2;
  font-weight: 700;
  margin-bottom: 24px;
}

.h-section {
  font-family: var(--font-head);
  font-size: 2.5rem;
  line-height: 1.3;
  font-weight: 700;
  margin-bottom: 16px;
}

.h-card {
  font-family: var(--font-head);
  font-size: 1.25rem;
  font-weight: 700;
  margin-bottom: 8px;
}

.lead {
  font-size: 1.125rem;
  color: var(--text-muted);
  margin-bottom: 16px;
  line-height: 1.7;
}

.body {
  font-size: 1rem;
  color: var(--text);
  line-height: 1.7;
}

.eyebrow {
  font-size: 0.875rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--accent);
  margin-bottom: 12px;
}

/* ============================================================================
   BUTTONS
   ============================================================================ */

.btn {
  padding: 12px 24px;
  border: none;
  border-radius: var(--radius-btn);
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  font-family: var(--font-body);
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.btn--primary {
  background: var(--accent);
  color: white;
}

.btn--primary:hover {
  background: var(--accent-deep);
  box-shadow: var(--shadow-card-hover);
}

.btn--ghost {
  background: transparent;
  color: var(--accent);
  border: 2px solid var(--accent);
}

.btn--ghost:hover {
  background: var(--accent-muted);
}

.btn--lg {
  padding: 16px 32px;
  font-size: 1.125rem;
}

.arrow {
  display: inline-block;
}

/* ============================================================================
   HERO SECTION
   ============================================================================ */

.hero-section {
  background: var(--bg);
  padding: var(--section-y) var(--section-x);
  min-height: 600px;
  display: flex;
  align-items: center;
}

.hero-inner {
  max-width: 1200px;
  margin: 0 auto;
  width: 100%;
}

.hero-container {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
}

/* Phone mockup */
.hero-mockup {
  display: flex;
  justify-content: center;
  align-items: center;
}

.phone-frame {
  width: 280px;
  height: 560px;
  background: #1a1a1a;
  border: 12px solid #1a1a1a;
  border-radius: 50px;
  overflow: hidden;
  position: relative;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
}

.phone-frame::before {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 180px;
  height: 28px;
  background: #1a1a1a;
  border-radius: 0 0 20px 20px;
  z-index: 10;
}

.phone-screen {
  width: 100%;
  height: 100%;
  background: white;
  overflow: hidden;
}

.phone-screen img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Hero text */
.hero-text {
  padding: 40px 0;
}

.persona-tabs {
  display: flex;
  gap: 12px;
  margin-bottom: 32px;
  border-bottom: 2px solid var(--surface-deep);
  padding-bottom: 16px;
}

.persona-tab {
  background: transparent;
  border: none;
  color: var(--text-muted);
  font-weight: 600;
  font-size: 0.95rem;
  cursor: pointer;
  padding: 8px 0;
  position: relative;
  transition: color 0.3s ease;
}

.persona-tab:hover {
  color: var(--text);
}

.persona-tab.active {
  color: var(--accent);
}

.persona-tab.active::after {
  content: '';
  position: absolute;
  bottom: -18px;
  left: 0;
  right: 0;
  height: 3px;
  background: var(--accent);
  border-radius: 2px;
}

.hero-content {
  margin-top: 24px;
}

.hero-ctas {
  display: flex;
  gap: 16px;
  margin-top: 32px;
}

/* ============================================================================
   FEATURES SECTION
   ============================================================================ */

.features-section {
  background: var(--surface);
  padding: var(--section-y) var(--section-x);
}

.features-inner {
  max-width: 1200px;
  margin: 0 auto;
  width: 100%;
}

.features-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 32px;
  margin-top: 48px;
}

.feature-card {
  background: var(--surface-alt);
  padding: 32px;
  border-radius: var(--radius-card);
  border: 1px solid var(--border);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.feature-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-card-hover);
}

.feature-icon {
  font-size: 2.5rem;
  margin-bottom: 12px;
  display: block;
}

/* ============================================================================
   PRICING SECTION
   ============================================================================ */

.pricing-section {
  background: var(--surface);
  padding: var(--section-y) var(--section-x);
}

.pricing-inner {
  max-width: 1200px;
  margin: 0 auto;
  width: 100%;
}

.pricing-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 32px;
  margin-top: 48px;
}

.pricing-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-card);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.pricing-card:hover {
  box-shadow: var(--shadow-card-hover);
}

/* ============================================================================
   STORY SECTION
   ============================================================================ */

.story-section {
  background: var(--bg);
  padding: var(--section-y) var(--section-x);
}

.story-inner {
  max-width: 1200px;
  margin: 0 auto;
  width: 100%;
}

.story-container {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  align-items: center;
  margin-bottom: 80px;
}

.story-image {
  width: 100%;
  height: 400px;
  background: linear-gradient(135deg, #c5dace, #e8f0e8);
  border-radius: var(--radius-card);
  overflow: hidden;
}

.story-forest {
  width: 100%;
  height: 100%;
}

.story-text .h-section {
  margin-bottom: 20px;
}

.story-text .lead {
  margin-bottom: 20px;
}

/* Field Journal */
.field-journal-container {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 50px;
  align-items: center;
}

.field-journal-image {
  width: 100%;
  height: 350px;
  border-radius: var(--radius-card);
  overflow: hidden;
}

.field-journal-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.field-journal-text .h-card {
  margin-top: 0;
}

.feature-list {
  list-style: none;
  margin-top: 20px;
}

.feature-list li {
  padding: 10px 0 10px 30px;
  position: relative;
}

.feature-list li::before {
  content: '✓';
  position: absolute;
  left: 0;
  color: var(--accent);
  font-weight: bold;
  font-size: 1.2rem;
}

/* ============================================================================
   TEAM SECTION
   ============================================================================ */

.team-section {
  background: var(--surface);
  padding: var(--section-y) var(--section-x);
}

.team-inner {
  max-width: 1200px;
  margin: 0 auto;
  width: 100%;
}

.team-carousel {
  display: flex;
  overflow-x: auto;
  gap: 24px;
  padding-bottom: 16px;
  margin-top: 48px;
}

.team-card {
  flex-shrink: 0;
  width: 256px;
  background: var(--surface-alt);
  border: 1px solid var(--border);
  border-radius: var(--radius-card);
  padding: 24px;
  text-align: center;
  transition: opacity 0.3s ease;
}

.team-avatar {
  width: 80px;
  height: 80px;
  background: var(--accent);
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 2rem;
  font-weight: bold;
  margin: 0 auto 16px;
}

/* ============================================================================
   TESTIMONIALS SECTION
   ============================================================================ */

.testimonials-section {
  background: var(--bg);
  padding: var(--section-y) var(--section-x);
}

.testimonials-inner {
  max-width: 1200px;
  margin: 0 auto;
  width: 100%;
}

.testimonial-card {
  background: var(--surface);
  padding: 32px;
  border-radius: var(--radius-card);
  border-left: 4px solid var(--accent);
  box-shadow: var(--shadow-card);
}

.testimonial-card .body {
  font-style: italic;
  margin-bottom: 16px;
}

/* ============================================================================
   PRIVACY SECTION
   ============================================================================ */

.privacy-section {
  background: var(--surface-deep);
  padding: var(--section-y) var(--section-x);
}

.privacy-inner {
  max-width: 1200px;
  margin: 0 auto;
  width: 100%;
}

/* ============================================================================
   FOOTER
   ============================================================================ */

.footer {
  background: var(--text);
  color: white;
  padding: 60px var(--section-x) 24px;
}

.footer-inner {
  max-width: 1200px;
  margin: 0 auto;
  width: 100%;
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 40px;
  margin-bottom: 40px;
}

.footer-column {
  min-width: 200px;
}

.footer-title {
  font-family: var(--font-head);
  font-size: 1.1rem;
  font-weight: 700;
  margin-bottom: 16px;
}

.footer-desc {
  font-size: 0.95rem;
  line-height: 1.6;
  margin-bottom: 16px;
  opacity: 0.9;
}

.footer-links {
  list-style: none;
}

.footer-links li {
  margin-bottom: 12px;
}

.footer-links a {
  color: white;
  text-decoration: none;
  font-size: 0.95rem;
  opacity: 0.85;
  transition: opacity 0.3s ease;
}

.footer-links a:hover {
  opacity: 1;
}

.footer-badges {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.badge {
  display: inline-block;
  padding: 6px 12px;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 4px;
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
}

.footer-bottom {
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  padding-top: 24px;
  text-align: center;
}

.footer-copyright {
  font-size: 0.9rem;
  opacity: 0.7;
}

/* ============================================================================
   RESPONSIVE DESIGN
   ============================================================================ */

@media (max-width: 768px) {
  :root {
    --section-y: 64px;
    --section-x: 20px;
  }

  .h-display {
    font-size: 2.5rem;
  }

  .h-section {
    font-size: 1.75rem;
  }

  .hero-container,
  .story-container,
  .field-journal-container {
    grid-template-columns: 1fr;
    gap: 40px;
  }

  .features-grid,
  .pricing-grid,
  .team-carousel {
    grid-template-columns: 1fr;
  }

  .hero-ctas {
    flex-direction: column;
  }

  .btn--lg {
    width: 100%;
    justify-content: center;
  }

  .footer-inner {
    grid-template-columns: repeat(2, 1fr);
  }

  .md-nav-links {
    display: none !important;
  }
}

@media (max-width: 480px) {
  :root {
    --section-y: 48px;
    --section-x: 16px;
  }

  .h-display {
    font-size: 2rem;
  }

  .h-section {
    font-size: 1.5rem;
  }

  .persona-tabs {
    flex-wrap: wrap;
  }

  .footer-inner {
    grid-template-columns: 1fr;
  }

  .hero-container {
    grid-template-columns: 1fr;
  }
}

/* ============================================================================
   ANCHOR SECTIONS - Privacy, Terms, Cookies, Contact
   ============================================================================ */

.anchor-section {
  padding: 6rem 2rem;
  scroll-margin-top: 80px;
}

.anchor-inner {
  max-width: 900px;
  margin: 0 auto;
}

.privacy-anchor-section {
  background-color: var(--bg);
}

.privacy-details {
  background-color: var(--surface);
  border-radius: 8px;
  padding: 2rem;
  margin: 2rem 0;
  border-left: 4px solid var(--accent);
}

.compliance-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 2rem;
  margin-top: 3rem;
}

.compliance-item {
  background-color: var(--surface-alt);
  padding: 1.5rem;
  border-radius: 6px;
  border-top: 3px solid var(--accent);
}

.compliance-item h4 {
  margin-bottom: 0.75rem;
  color: var(--text);
}

.compliance-item p {
  color: var(--text-muted);
  font-size: 0.95rem;
  line-height: 1.6;
}

.terms-anchor-section {
  background-color: var(--surface);
}

.cookies-anchor-section {
  background-color: var(--surface-alt);
}

.contact-anchor-section {
  background-color: var(--surface);
}

.anchor-section .link,
.anchor-section a {
  color: var(--accent);
  text-decoration: none;
  border-bottom: 1px solid var(--accent);
  transition: all 0.3s ease;
}

.anchor-section .link:hover,
.anchor-section a:hover {
  color: var(--accent-deep);
  border-bottom-color: var(--accent-deep);
}

@media (max-width: 768px) {
  .anchor-section {
    padding: 3rem 1.5rem;
  }

  .anchor-inner {
    padding: 0 1rem;
  }

  .privacy-details {
    padding: 1.5rem;
  }

  .compliance-grid {
    grid-template-columns: 1fr;
  }
}

@media print {
  .anchor-section {
    page-break-inside: avoid;
  }
}
</file>

