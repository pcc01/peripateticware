}

.sihw-ai-showcase {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
  align-items: center;
  margin-top: 48px;
}

.sihw-ai-bubble {
  background-color: white;
  padding: 24px;
  border-radius: 16px;
  border: 1px solid var(--border);
}

.sihw-ai-example {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.sihw-chat-msg {
  padding: 12px 16px;
  border-radius: 12px;
  font-size: 13px;
  line-height: 1.6;
}

.sihw-chat-msg.user {
  background-color: var(--accent);
