import React from 'react'
import ReactDOM from 'react-dom/client'
import i18n from './config/i18n'
import App from './App'
import './design-system.css'

// ============================================================================
// ✅ CRITICAL FIX: Wait for i18n to initialize before rendering
// ============================================================================
// The problem: React was rendering App before i18n finished loading the
// namespace files from /locales/en/landing.json, etc.
//
// The solution: Listen for the 'initialized' event, which fires when i18n
// has finished loading all configured namespaces. Only then render the app.

let root: ReturnType<typeof ReactDOM.createRoot> | null = null

function renderApp() {
  if (!root) {
    root = ReactDOM.createRoot(document.getElementById('root')!)
  }
  root.render(
    <React.StrictMode>
      <App />
    </React.StrictMode>,
  )
}

function startApp() {
  // Wait for i18n to be ready before rendering
  if (i18n.isInitialized) {
    // Already initialized
    renderApp()
  } else {
    // Listen for initialization complete
    i18n.on('initialized', () => {
      renderApp()
    })

    // Fallback: if initialization takes too long, render anyway
    setTimeout(() => {
      renderApp()
    }, 5000)
  }
}

// Start the app
startApp()
</file>

