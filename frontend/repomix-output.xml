// found in the LICENSE.md file in the root directory of this source tree.

import React, { useState } from 'react';
import { useNavigate } from 'react-router-dom';
import { useTranslation } from 'react-i18next';
import { Plus, Search, Filter, MoreVertical, Eye, Edit, Trash2 } from 'lucide-react';
import { useApiData, useTeacher } from '@/services/api';
import { ActivityQueryParams } from '@/services/api';

/**
 * TeacherActivityListPage
 * Route: /teacher/activities
 * Accessible from: TeacherDashboard → Navigation → "Activities"
 * 
 * Uses: TeacherService.getActivities()
 * Functions:
 * - Display all teacher activities
 * - Filter by status, subject, sort
 * - Create new activity
 * - View/edit/delete activity
 */

export const TeacherActivityListPage: React.FC = () => {
  const navigate = useNavigate();
  const { t } = useTranslation();
  const { getActivities, deleteActivity } = useTeacher();

  // State
  const [searchQuery, setSearchQuery] = useState('');
  const [statusFilter, setStatusFilter] = useState<'all' | 'active' | 'completed' | 'pending'>('all');
  const [page, setPage] = useState(0);

  // Fetch activities with filtering
  const params: ActivityQueryParams = {
    skip: page * 10,
    limit: 10,
    status: statusFilter === 'all' ? undefined : statusFilter
  };

  const { data: activitiesData, loading, error, refetch } = useApiData(
    () => getActivities(params),
    [page, statusFilter]
  );

  const handleCreateActivity = () => {
    navigate('/teacher/activities/new');
  };

  const handleViewActivity = (activityId: string) => {
    navigate(`/teacher/activities/${activityId}`);
  };

  const handleEditActivity = (activityId: string) => {
    navigate(`/teacher/activities/${activityId}/edit`);
  };

  const handleDeleteActivity = async (activityId: string) => {
    if (confirm('Are you sure you want to delete this activity?')) {
      try {
        await deleteActivity(activityId);
        refetch();
      } catch (err) {
        console.error('Delete failed:', err);
      }
    }
  };

  return (
    <div className="flex-1 bg-gray-50">
      {/* Header */}
      <div className="bg-white shadow">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
          <div className="flex justify-between items-start gap-4">
            <div>
              <h1 className="text-3xl font-bold text-gray-900">
                {t('pages.teacher.activities.title', 'My Activities')}
              </h1>
              <p className="text-gray-600 mt-2">
                {t('pages.teacher.activities.subtitle', 'Create and manage your learning activities')}
              </p>
            </div>
            <button
              onClick={handleCreateActivity}
              className="flex items-center gap-2 bg-green-700 hover:bg-green-800 text-white px-4 py-2 rounded-lg font-medium">
              
              <Plus className="w-5 h-5" />
              {t('pages.teacher.activities.create_btn', 'Create Activity')}
            </button>
          </div>
        </div>
      </div>

      {/* Filters */}
      <div className="bg-white border-b p-4 mb-4">
        <div className="max-w-7xl mx-auto flex gap-4 flex-wrap">
          <div className="flex-1 min-w-64 relative">
            <Search className="absolute left-3 top-3 w-5 h-5 text-gray-400" />
            <input
              type="text"
              placeholder={t('common.search', 'Search')}
              value={searchQuery}
              onChange={(e) => setSearchQuery(e.target.value)}
              className="w-full pl-10 pr-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500" />
            
          </div>

          <select
            value={statusFilter}
            onChange={(e) => {
              setStatusFilter(e.target.value as any);
              setPage(0);
            }}
            className="px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500">
            
            <option value="all">{t('filters.status.all', 'All Status')}</option>
            <option value="active">{t('filters.status.active', 'Active')}</option>
            <option value="completed">{t('filters.status.completed', 'Completed')}</option>
            <option value="pending">{t('filters.status.pending', 'Pending')}</option>
          </select>
        </div>
      </div>

      {/* Content */}
      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
        {loading ?
        <div className="flex justify-center items-center h-64">
            <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-green-700"></div>
          </div> :
        error ?
        <div className="bg-red-50 border border-red-200 rounded-lg p-4">
            <p className="text-red-800">{error.message}</p>
            <button
            onClick={() => refetch()}
            className="mt-4 px-4 py-2 bg-red-700 text-white rounded hover:bg-red-800">
            
              {t('common.retry', 'Retry')}
            </button>
          </div> :
        activitiesData?.items && activitiesData.items.length > 0 ?
        <>
            <div className="grid gap-4">
              {activitiesData.items.map((activity) =>
            <div
              key={activity.id}
              className="bg-white rounded-lg shadow hover:shadow-lg transition p-4">
              
                  <div className="flex justify-between items-start gap-4">
                    <div className="flex-1 cursor-pointer" onClick={() => handleViewActivity(activity.id)}>
                      <h3 className="text-xl font-semibold text-gray-900 hover:text-green-700">
                        {activity.title}
                      </h3>
                      <p className="text-gray-600 mt-1">{activity.description}</p>
                      <div className="flex gap-4 mt-4 text-sm text-gray-600">
                        <span>📚 {activity.subject}</span>
                        <span>📍 {activity.location}</span>
                        <span>👥 {activity.student_count}{t("landing:teacheractivitylistpage.students", "students")}</span>
                        <span>📤 {activity.submissions_count}{t("landing:teacheractivitylistpage.submissions", "submissions")}</span>
                      </div>
                    </div>

                    <div className="text-right">
                      <div className="text-2xl font-bold text-green-700 mb-2">
                        {activity.progress}%
                      </div>
                      <div className="w-32 h-2 bg-gray-200 rounded-full overflow-hidden">
                        <div
                      className="h-full bg-green-700 transition-all"
                      style={{ width: `${activity.progress}%` }}>
                    </div>
                      </div>
                      <span className={`inline-block mt-2 px-3 py-1 rounded-full text-xs font-medium ${
                  activity.status === 'active' ?
                  'bg-blue-100 text-blue-800' :
                  activity.status === 'completed' ?
                  'bg-green-100 text-green-800' :
                  'bg-gray-100 text-gray-800'}`
                  }>
                        {activity.status}
                      </span>
                    </div>

                    {/* Actions Menu */}
                    <div className="relative group">
                      <button className="p-2 hover:bg-gray-100 rounded-lg">
                        <MoreVertical className="w-5 h-5 text-gray-600" />
                      </button>
                      <div className="hidden group-hover:block absolute right-0 mt-1 bg-white border rounded-lg shadow-lg z-10">
                        <button
                      onClick={() => handleViewActivity(activity.id)}
                      className="flex gap-2 w-full px-4 py-2 text-left hover:bg-gray-100 text-gray-700">
                      
                          <Eye className="w-4 h-4" />{t("landing:view", "View")}
                    </button>
                        <button
                      onClick={() => handleEditActivity(activity.id)}
                      className="flex gap-2 w-full px-4 py-2 text-left hover:bg-gray-100 text-gray-700">
                      
                          <Edit className="w-4 h-4" />{t("landing:teacheractivitylistpage.edit", "Edit")}
                    </button>
                        <button
                      onClick={() => handleDeleteActivity(activity.id)}
                      className="flex gap-2 w-full px-4 py-2 text-left hover:bg-red-50 text-red-700">
                      
                          <Trash2 className="w-4 h-4" />{t("landing:delete", "Delete")}
                    </button>
                      </div>
                    </div>
                  </div>
                </div>
            )}
            </div>

            {/* Pagination */}
            <div className="flex justify-center items-center gap-4 mt-8">
              <button
              onClick={() => setPage(Math.max(0, page - 1))}
              disabled={page === 0}
              className="px-4 py-2 border rounded-lg disabled:opacity-50 disabled:cursor-not-allowed hover:bg-gray-50">
              
                {t('common.previous', 'Previous')}
              </button>
              <span className="text-gray-600">{t("landing:page", "Page")}
              {page + 1}{t("landing:of", "of")}{Math.ceil((activitiesData?.total || 0) / 10)}
              </span>
              <button
              onClick={() => setPage(page + 1)}
              disabled={(page + 1) * 10 >= (activitiesData?.total || 0)}
              className="px-4 py-2 border rounded-lg disabled:opacity-50 disabled:cursor-not-allowed hover:bg-gray-50">
              
                {t('common.next', 'Next')}
              </button>
            </div>
          </> :

        <div className="text-center py-12">
            <p className="text-gray-600 text-lg">
              {t('pages.teacher.activities.empty', 'No activities yet. Create your first one!')}
            </p>
            <button
            onClick={handleCreateActivity}
            className="mt-4 px-6 py-2 bg-green-700 hover:bg-green-800 text-white rounded-lg font-medium">
            
              {t('pages.teacher.activities.create_first', 'Create First Activity')}
            </button>
          </div>
        }
      </div>
    </div>);

};

export default TeacherActivityListPage;
</file>

<file path="src/pages/TeacherDashboard.module.css">
/* TeacherDashboard.module.css - Uses existing design system */

.container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 40px;
  background-color: var(--bg);
  min-height: 100vh;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40px;
  padding-bottom: 24px;
  border-bottom: 1px solid var(--border);
}

.header h1 {
  font-family: var(--font-head);
  font-size: 2.5rem;
  font-weight: 700;
  margin: 0;
  color: var(--text);
}

.refreshBtn {
  padding: 10px 20px;
  background-color: var(--accent);
  color: white;
  border: none;
  border-radius: var(--radius-btn);
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
}

.refreshBtn:hover:not(:disabled) {
  background-color: var(--accent-deep);
  box-shadow: var(--shadow-card-hover);
}

.refreshBtn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.error {
  background-color: var(--warn-muted);
  border: 1px solid var(--warn);
  border-radius: var(--radius-card);
  padding: 16px;
  margin-bottom: 24px;
  color: var(--warn);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.error p {
  margin: 0;
  font-weight: 600;
}

.error button {
  background-color: transparent;
  color: var(--warn);
  border: 1px solid var(--warn);
  padding: 6px 12px;
  border-radius: 6px;
  cursor: pointer;
  font-size: 0.9rem;
  transition: all 0.2s ease;
}

.error button:hover {
  background-color: var(--warn);
  color: white;
}

/* STATS SECTION */
.statsSection {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 24px;
  margin-bottom: 48px;
}

.statCard {
  background-color: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-card);
  padding: 32px;
  box-shadow: var(--shadow-card);
  transition: all 0.2s ease;
}

.statCard:hover {
  box-shadow: var(--shadow-card-hover);
  transform: translateY(-4px);
}

.statLabel {
  font-size: 0.95rem;
  color: var(--text-muted);
  font-weight: 600;
  margin-bottom: 12px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.statValue {
  font-family: var(--font-head);
  font-size: 2.5rem;
  font-weight: 700;
  color: var(--accent);
  margin: 0;
}

.section {
  margin-bottom: 48px;
}

.sectionHeader {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
  padding-bottom: 16px;
  border-bottom: 1px solid var(--border);
}

.sectionHeader h2 {
  font-family: var(--font-head);
  font-size: 1.5rem;
  font-weight: 700;
  margin: 0;
  color: var(--text);
}

.createBtn {
  background-color: var(--accent);
  color: white;
  border: none;
  padding: 8px 16px;
  border-radius: var(--radius-btn);
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
}

.createBtn:hover {
  background-color: var(--accent-deep);
  box-shadow: var(--shadow-card-hover);
}

.viewAllBtn {
  background-color: transparent;
  color: var(--accent);
  border: 1px solid var(--accent);
  padding: 8px 16px;
  border-radius: var(--radius-btn);
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
}

.viewAllBtn:hover {
  background-color: var(--accent-muted);
}

/* ACTIVITIES TABLE */
.activitiesTable {
  background-color: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-card);
  overflow: hidden;
  box-shadow: var(--shadow-card);
}

.activitiesTable table {
  width: 100%;
  border-collapse: collapse;
}

.activitiesTable thead {
  background-color: var(--surface-alt);
  border-bottom: 2px solid var(--border);
}

.activitiesTable th {
  padding: 16px;
  text-align: left;
  font-weight: 700;
  color: var(--text);
  font-size: 0.9rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.activitiesTable tbody tr {
  border-bottom: 1px solid var(--border);
  transition: background-color 0.2s ease;
}

.activitiesTable tbody tr:hover {
  background-color: var(--surface-alt);
}

.activitiesTable td {
  padding: 16px;
  color: var(--text);
  font-size: 0.95rem;
}

.title {
  font-weight: 600;
  color: var(--accent);
  cursor: pointer;
}

.status {
  display: inline-block;
  padding: 4px 12px;
  border-radius: var(--radius-pill);
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.status.active {
  background-color: #e8f5e9;
  color: var(--accent);
}

.status.completed {
  background-color: #f0f0f0;
  color: var(--text-muted);
}

.status.pending {
  background-color: var(--warn-muted);
  color: var(--warn);
}

.status.draft {
  background-color: #f3e5f5;
  color: #7b1fa2;
}

.actions {
  display: flex;
  gap: 8px;
}

.actions button {
  background-color: var(--accent-muted);
  color: var(--accent);
  border: none;
  padding: 6px 12px;
  border-radius: 6px;
  font-size: 0.85rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
}

.actions button:hover {
  background-color: var(--accent);
  color: white;
}

/* SUBMISSIONS LIST */
.submissionsList {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.submissionItem {
  background-color: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-card);
  padding: 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: all 0.2s ease;
}

.submissionItem:hover {
  box-shadow: var(--shadow-card-hover);
  background-color: var(--surface-alt);
}

.submissionInfo h3 {
  font-family: var(--font-head);
  font-size: 1.1rem;
  font-weight: 700;
  margin: 0 0 4px 0;
  color: var(--text);
}

.projectId {
  font-size: 0.85rem !important;
  color: var(--text-muted) !important;
}

.submissionInfo small {
  display: block;
  font-size: 0.85rem;
  color: var(--text-faint);
  margin-top: 4px;
}

.submissionStatus {
  display: inline-block;
  padding: 6px 12px;
  border-radius: 6px;
  font-size: 0.8rem;
  font-weight: 600;
  margin-right: 12px;
  text-transform: capitalize;
}

.submissionStatus.submitted {
  background-color: #fff3e0;
  color: #f57c00;
}

.submissionStatus.graded {
  background-color: #e8f5e9;
  color: var(--accent);
}

.submissionStatus.pending {
  background-color: var(--warn-muted);
  color: var(--warn);
}

.gradeBtn {
  background-color: var(--accent);
  color: white;
  border: none;
  padding: 8px 16px;
  border-radius: var(--radius-btn);
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
}

.gradeBtn:hover {
  background-color: var(--accent-deep);
}

/* CLASSES GRID */
.classesGrid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 24px;
}

.classCard {
  background-color: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-card);
  padding: 24px;
  box-shadow: var(--shadow-card);
  cursor: pointer;
  transition: all 0.2s ease;
}

.classCard:hover {
  box-shadow: var(--shadow-card-hover);
  transform: translateY(-4px);
}

.classCard h3 {
  font-family: var(--font-head);
  font-size: 1.2rem;
  font-weight: 700;
  margin: 0 0 8px 0;
  color: var(--text);
}

.classCard p {
  margin: 0 0 12px 0;
  color: var(--text-muted);
  font-size: 0.95rem;
}

.classInfo {
  display: flex;
  gap: 16px;
  font-size: 0.85rem;
  color: var(--text-faint);
  padding-top: 12px;
  border-top: 1px solid var(--border);
}

/* STUDENTS LIST */
.studentsList {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.studentItem {
  background-color: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-card);
  padding: 16px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: all 0.2s ease;
}

.studentItem:hover {
  background-color: var(--surface-alt);
  box-shadow: var(--shadow-card-hover);
}

.studentInfo h4 {
  font-family: var(--font-head);
  font-weight: 700;
  margin: 0 0 4px 0;
  color: var(--text);
  font-size: 1rem;
}

.studentInfo p {
  margin: 0;
  font-size: 0.85rem;
  color: var(--text-muted);
}

.viewBtn {
  background-color: transparent;
  color: var(--accent);
  border: 1px solid var(--accent);
  padding: 6px 12px;
  border-radius: 6px;
  font-size: 0.85rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
}

.viewBtn:hover {
  background-color: var(--accent);
  color: white;
}

.emptyState {
  background-color: var(--surface-alt);
  border: 1px solid var(--border);
  border-radius: var(--radius-card);
  padding: 60px 40px;
  text-align: center;
}

.emptyState p {
  color: var(--text-muted);
  font-size: 1rem;
  margin: 0;
}

.loading {
  background-color: var(--surface);
  border-radius: var(--radius-card);
  padding: 60px 40px;
  text-align: center;
}

.loading p {
  color: var(--text-muted);
  font-size: 1rem;
  margin: 0;
}

/* Responsive */
@media (max-width: 768px) {
  .container {
    padding: 20px;
  }

  .header {
    flex-direction: column;
    gap: 16px;
    align-items: flex-start;
  }

  .header h1 {
    font-size: 1.75rem;
  }

  .statsSection {
    grid-template-columns: repeat(2, 1fr);
  }

  .classesGrid {
    grid-template-columns: 1fr;
  }

  .activitiesTable {
    overflow-x: auto;
  }

  .submissionItem {
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .gradeBtn {
    width: 100%;
  }
    .settingsBtn {
      padding: var(--space-md) var(--space-lg);
      background-color: transparent;
      color: var(--primary);
      border: 1px solid var(--primary);
      border-radius: var(--radius-md);
      font-weight: 600;
      cursor: pointer;
      transition: all var(--duration-base) var(--ease-in-out);
      font-size: var(--font-size-base);
    }
  
    .settingsBtn:hover {
      background-color: var(--primary-muted);
      box-shadow: var(--shadow-card-hover);
    }
  
    .navGrid,
    .adminNav {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: var(--space-lg);
      margin-top: var(--space-xl);
    }
  
    .navCard {
      padding: var(--space-xl);
      background-color: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      font-weight: 600;
      cursor: pointer;
      transition: all var(--duration-base) var(--ease-in-out);
      text-align: center;
      font-size: var(--font-size-base);
      color: var(--text);
    }
  
    .navCard:hover {
      box-shadow: var(--shadow-card-hover);
      transform: translateY(-4px);
      background-color: var(--primary-muted);
      border-color: var(--primary); }
}
</file>

