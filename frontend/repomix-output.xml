      <path d="M 68 56 Q 72 60 76 65" fill="none" stroke="#1a1a1a" strokeWidth="0.7" opacity="0.5" />

      {/* Tail feathers - ascending flowing lines */}
      <path d="M 43 72 Q 40 80 38 88" fill="none" stroke="#1a1a1a" strokeWidth="1.1" strokeLinecap="round" />
      <path d="M 50 72 Q 50 82 50 90" fill="none" stroke="#1a1a1a" strokeWidth="1.1" strokeLinecap="round" />
      <path d="M 57 72 Q 60 80 62 88" fill="none" stroke="#1a1a1a" strokeWidth="1.1" strokeLinecap="round" />

      {/* Feet - minimal */}
      <line x1="47" y1="72" x2="47" y2="76" stroke="#1a1a1a" strokeWidth="0.7" strokeLinecap="round" />
      <line x1="53" y1="72" x2="53" y2="76" stroke="#1a1a1a" strokeWidth="0.7" strokeLinecap="round" />
      <path d="M 45 76 L 55 76" fill="none" stroke="#1a1a1a" strokeWidth="0.8" strokeLinecap="round" />
