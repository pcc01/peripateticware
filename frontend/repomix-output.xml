        {/* Actions */}
        <div className="flex gap-lg" style={{ justifyContent: 'flex-end' }}>
          <button className="btn btn-secondary" onClick={() => navigate('/teacher/projects')}>{t("landing:projectdetailpage.back", "Back")}

