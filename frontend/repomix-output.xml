  email: string;
  username: string;
  full_name: string;
  password: string;
  role: 'STUDENT' | 'TEACHER' | 'PARENT' | 'ADMIN';
}

export interface LoginPayload {
  username: string;
  password: string;
}

export interface ForgotPasswordPayload {
  email: string;
}

