  setFilters: (filters: Partial<CaptureFilters>) => void;
  selectCapture: (capture: Capture | null) => void;
  clearError: () => void;
}

export const useCaptureStore = create<CaptureState>((set, get) => ({
  // Initial state
  captures: [],
  selectedCapture: null,
  paginatedCaptures: null,
  loading: false,
