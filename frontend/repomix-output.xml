// frontend/scripts/ast_tagger.cjs
const fs = require('fs');
const path = require('path');

const SRC_DIR = path.resolve(__dirname, '../src');
const MASTER_EN_PATH = path.resolve(__dirname, '../public/locales/en/landing.json');

/**
 * Safely inserts translation parameters into a deeply nested namespace structure
 * without corrupting parent/child data types.
 */
function assignNestedKey(targetObj, keyPath, fallbackValue) {
  const pieces = keyPath.split('.');
  let current = targetObj;

  for (let i = 0; i < pieces.length; i++) {
    const piece = pieces[i];
    if (i === pieces.length - 1) {
      if (!current[piece] || current[piece] === fallbackValue) {
        current[piece] = fallbackValue;
      }
    } else {
      if (!current[piece] || typeof current[piece] !== 'object') {
        current[piece] = {};
      }
      current = current[piece];
    }
  }
}

/**
 * PURE READ-ONLY SWEEP: Scrapes execution contexts via high-precision regular expressions
 */
function scanFileForLocalizationTokens(fileContent, masterCatalog) {
  // Regex 1: Matches explicit invocations with fallbacks -> t("auth.email_label", "Email Address")
  const explicitCallRegex = /\bt\(\s*['"](?:landing:)?([a-zA-Z0-9_\-\.]+)(?:['"])\s*,\s*['"](.*?)['"]\s*\)/g;

  // Regex 2: Matches implicit structural configuration strings -> t('nav.teacher.dashboard')
  const implicitCallRegex = /\bt\(\s*['"](?:landing:)?([a-zA-Z0-9_\-\.]+)(?:['"])\s*\)/g;

  let match;

  while ((match = explicitCallRegex.exec(fileContent)) !== null) {
    const keyPath = match[1];
    const defaultText = match[2].replace(/\\u([0-9a-fA-F]{4})/g, (m, grp) => String.fromCharCode(parseInt(grp, 16)));
    assignNestedKey(masterCatalog, keyPath, defaultText);
  }

  while ((match = implicitCallRegex.exec(fileContent)) !== null) {
    const keyPath = match[1];
    const fallbackLabel = keyPath.split('.').pop().replace(/_/g, ' ');
    assignNestedKey(masterCatalog, keyPath, fallbackLabel);
  }
}

/**
 * Hardcoded text literal harvester for plain JSX markup nodes
 */
function scanForHardcodedElements(fileContent, filenameScope, masterCatalog) {
  const jsxTagRegex = /<(?:label|h1|h2|h3|h4|p)[^>]*>([^<>{|}]+)<\/(?:label|h1|h2|h3|h4|p)>/g;
  let match;

  while ((match = jsxTagRegex.exec(fileContent)) !== null) {
    const rawText = match[1].trim();
    if (rawText && !/^[0-9\s\-\+\:\(\)\x21-\x2F]+$/.test(rawText) && !rawText.startsWith('{')) {
      const cleanKey = rawText.toLowerCase()
        .replace(/[^a-z0-9_\s]/g, '')
        .trim()
        .replace(/\s+/g, '_')
        .substring(0, 30);

      if (cleanKey) {
        const scopedPath = `${filenameScope}.${cleanKey}`;
        assignNestedKey(masterCatalog, scopedPath, rawText);
      }
    }
  }
}

function crawlAndHarvestLocales() {
  console.log('🔍 Running Read-Only Broad-Spectrum Token Extraction Engine...');

  let currentMasterCatalog = {};
  if (fs.existsSync(MASTER_EN_PATH)) {
    try {
      currentMasterCatalog = JSON.parse(fs.readFileSync(MASTER_EN_PATH, 'utf-8'));
    } catch (e) {
      currentMasterCatalog = {};
    }
  }

  let totalFilesScanned = 0;

  function processDirectory(currentPath) {
    const items = fs.readdirSync(currentPath);

    for (const item of items) {
      const fullPath = path.join(currentPath, item);
      const stat = fs.statSync(fullPath);

      if (stat.isDirectory()) {
        if (item !== 'node_modules' && item !== 'public' && item !== 'dist') {
          processDirectory(fullPath);
        }
      } else if (stat.isFile() && /\.(ts|tsx|js|jsx)$/.test(item)) {
        const fileContent = fs.readFileSync(fullPath, 'utf-8');

        // Read contents statically without changing code layout!
        scanFileForLocalizationTokens(fileContent, currentMasterCatalog);
        totalFilesScanned++;
      }
    }
  }

  if (fs.existsSync(SRC_DIR)) {
    processDirectory(SRC_DIR);
  }

  fs.mkdirSync(path.dirname(MASTER_EN_PATH), { recursive: true });
  fs.writeFileSync(MASTER_EN_PATH, JSON.stringify(currentMasterCatalog, null, 2), 'utf-8');

  const keyCount = Object.keys(currentMasterCatalog).length;
  console.log(`\n✅ Safe localization harvest complete.`);
  console.log(`📊 Scanned files: ${totalFilesScanned} | Mapped root structures: ${keyCount}`);
}

crawlAndHarvestLocales();
