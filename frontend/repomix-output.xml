  border: none;
  padding: 8px 16px;
  border-radius: var(--radius-btn);
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
  white-space: nowrap;
}

.joinBtn:hover {
  background-color: var(--accent-deep);
}

.activitiesGrid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 24px;
}

.activityCard {
  background-color: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-card);
  padding: 24px;
  box-shadow: var(--shadow-card);
  cursor: pointer;
  transition: all 0.2s ease;
}

.activityCard:hover {
  box-shadow: var(--shadow-card-hover);
  transform: translateY(-4px);
}

.activityHeader {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12px;
}

.activityHeader h3 {
  font-family: var(--font-head);
  font-size: 1.1rem;
  font-weight: 700;
  margin: 0;
  color: var(--text);
  flex: 1;
}

.status {
  display: inline-block;
  padding: 4px 12px;
  border-radius: var(--radius-pill);
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.status.active {
  background-color: #e8f5e9;
  color: var(--accent);
}

.status.completed {
  background-color: #f0f0f0;
  color: var(--text-muted);
}

.status.pending {
  background-color: var(--warn-muted);
  color: var(--warn);
}

.dueDate {
  font-size: 0.85rem;
  color: var(--text-faint);
  margin-top: 12px;
  padding-top: 12px;
  border-top: 1px solid var(--border);
}

.evidenceList {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.evidenceItem {
  background-color: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-card);
  padding: 16px;
  display: flex;
  gap: 16px;
  align-items: flex-start;
}

.evidenceType {
  display: inline-block;
  padding: 6px 12px;
  background-color: var(--accent-muted);
  color: var(--accent);
  border-radius: 6px;
  font-size: 0.8rem;
  font-weight: 600;
  text-transform: capitalize;
  white-space: nowrap;
}

.evidenceInfo {
  flex: 1;
}

.evidenceInfo p {
  margin: 0 0 4px 0;
  font-size: 0.95rem;
  color: var(--text);
}

.evidenceInfo small {
  color: var(--text-faint);
  font-size: 0.85rem;
}

.emptyState {
  background-color: var(--surface-alt);
  border: 1px solid var(--border);
  border-radius: var(--radius-card);
  padding: 60px 40px;
  text-align: center;
}

.emptyState p {
  color: var(--text-muted);
  font-size: 1rem;
  margin: 0;
}

.loading {
  background-color: var(--surface);
  border-radius: var(--radius-card);
  padding: 60px 40px;
  text-align: center;
}

.loading p {
  color: var(--text-muted);
  font-size: 1rem;
  margin: 0;
}

/* Responsive */
@media (max-width: 768px) {
  .container {
    padding: 20px;
  }

  .header {
    flex-direction: column;
    gap: 16px;
    align-items: flex-start;
  }

  .header h1 {
    font-size: 1.75rem;
  }

  .projectGrid,
  .activitiesGrid {
    grid-template-columns: 1fr;
  }

  .sessionItem {
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .joinBtn {
    width: 100%;
  }
    .settingsBtn {
      padding: var(--space-md) var(--space-lg);
      background-color: transparent;
      color: var(--primary);
      border: 1px solid var(--primary);
      border-radius: var(--radius-md);
      font-weight: 600;
      cursor: pointer;
      transition: all var(--duration-base) var(--ease-in-out);
      font-size: var(--font-size-base);
    }
  
    .settingsBtn:hover {
      background-color: var(--primary-muted);
      box-shadow: var(--shadow-card-hover);
    }
  
    .navGrid,
    .adminNav {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: var(--space-lg);
      margin-top: var(--space-xl);
    }
  
    .navCard {
      padding: var(--space-xl);
      background-color: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      font-weight: 600;
      cursor: pointer;
      transition: all var(--duration-base) var(--ease-in-out);
      text-align: center;
      font-size: var(--font-size-base);
      color: var(--text);
    }
  
    .navCard:hover {
      box-shadow: var(--shadow-card-hover);
      transform: translateY(-4px);
      background-color: var(--primary-muted);
      border-color: var(--primary); }
}
