}

/* FOOTER */
.sihw-footer {
  padding: 48px 40px;
  border-top: 1px solid var(--border);
  background-color: var(--surface-alt);
  text-align: center;
}

.sihw-footer p {
  font-size: 13px;
  color: var(--text-muted);
  margin: 0;
}

/* RESPONSIVE */
@media (max-width: 768px) {
  .sihw-feature-grid,
  .sihw-tools-grid,
  .sihw-portfolio-features {
    grid-template-columns: 1fr;
  }

  .sihw-ai-showcase {
    grid-template-columns: 1fr;
  }

  .sihw-headline {
    font-size: 32px;
  }

  .sihw-section-title {
    font-size: 24px;
  }
}
</file>

