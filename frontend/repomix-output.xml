}

export interface PrivacySettings {
  shareProgress: boolean;
  allowMessages: boolean;
  dataCollection: 'minimal' | 'standard' | 'full';
}

// API Response Types
export interface ApiResponse<T> {
  data: T;
  status: number;
  message?: string;
}

export interface ApiError {
  message: string;
  code: string;
  status: number;
