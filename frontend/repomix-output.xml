// ============================================================================
// ACTIVITY API ENDPOINTS
// ============================================================================

export const studentActivityApi = {
  /**
   * Get current activity engagement
   */
  async getCurrentActivity(sessionId: string): Promise<any> {
    const response = await apiClient.get(
