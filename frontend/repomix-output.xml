<file path="src/components/PhoneCarousel.css">
/* Phone Carousel Component */

.carousel-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24px;
  margin: 40px 0;
}

/* PHONE MOCKUP */
.phone-mockup {
  aspect-ratio: 9 / 19;
  width: 100%;
  max-width: 340px;
  border-radius: 32px;
  padding: 12px;
  box-shadow: 0 28px 60px rgba(30, 26, 20, 0.30), 0 0 0 6px rgba(30, 26, 20, 0.08);
  border: 1px solid #e0d8cb;
}

.phone-inner {
  width: 100%;
  height: 100%;
  background-color: white;
  border-radius: 26px;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border: 1px solid #e0d8cb;
}

.phone-header {
  height: 32px;
  background-color: #f5f0e6;
  border-bottom: 1px solid #e0d8cb;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 12px;
  font-size: 11px;
  font-weight: 600;
}

.phone-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* CAROUSEL IMAGE/PLACEHOLDER */
.carousel-image {
  height: 140px;
  background-size: cover;
  background-position: center;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom: 1px solid #e0d8cb;
  position: relative;
}

.carousel-placeholder {
  height: 140px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-bottom: 1px solid #e0d8cb;
  position: relative;
}

.carousel-emoji,
.placeholder-emoji {
  font-size: 48px;
  margin-bottom: 8px;
}

.placeholder-text {
  font-size: 10px;
  font-weight: 600;
  color: #7a6f5e;
  text-align: center;
  padding: 0 8px;
}

/* CAROUSEL TEXT */
.carousel-text {
  flex: 1;
  overflow-y: auto;
  padding: 12px;
  font-size: 11px;
  line-height: 1.4;
}

.carousel-title {
  font-size: 12px;
  font-weight: 700;
  margin: 0 0 4px 0;
  color: #1e1a14;
}

.carousel-subtitle {
  font-size: 10px;
  color: #7a6f5e;
  margin: 0 0 8px 0;
}

.carousel-prompt,
.carousel-response {
  margin: 8px 0;
  padding: 8px;
  border-radius: 8px;
  background-color: #f5f0e6;
  border: 1px solid #e0d8cb;
}

.prompt-label,
.response-label {
  font-size: 8px;
  font-weight: 700;
  color: #4a7c59;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 4px;
}

.prompt-text,
.response-text {
  font-size: 10px;
  color: #1e1a14;
  margin: 0;
  line-height: 1.5;
}

.carousel-response {
  background-color: #eaf2ec;
}

.response-label {
  color: #4a7c59;
}

/* INDICATORS */
.phone-indicators {
  display: flex;
  justify-content: center;
  gap: 6px;
  padding: 8px;
  border-top: 1px solid #e0d8cb;
  background-color: #faf7f2;
}

.indicator {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background-color: #e0d8cb;
  cursor: pointer;
  transition: all 0.3s;
}

.indicator.active {
  background-color: #4a7c59;
  width: 16px;
  border-radius: 3px;
}

/* CONTROLS */
.carousel-controls {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16px;
}

.carousel-btn {
  padding: 8px 16px;
  border: 1px solid #e0d8cb;
  border-radius: 8px;
  background-color: white;
  cursor: pointer;
  font-size: 12px;
  font-weight: 600;
  transition: all 0.2s;
}

.carousel-btn:hover {
  background-color: #f5f0e6;
  border-color: #4a7c59;
}

.carousel-counter {
  font-size: 12px;
  color: #7a6f5e;
  font-weight: 600;
  min-width: 50px;
  text-align: center;
}

/* RESPONSIVE */
@media (max-width: 768px) {
  .carousel-controls {
    flex-direction: column;
    gap: 12px;
  }

  .carousel-btn {
    width: 100%;
  }
}
</file>

<file path="src/components/PhoneCarousel.tsx">
/**
 * Peripateticware - PhoneCarousel.tsx
 * Business Source License 1.1 — see LICENSE
 *
 * FIX: useTranslation() was called at module level (line 2 of original),
 * outside any React component. This violated Rules of Hooks and crashed the
 * entire app before the React tree could mount. Moved inside component body.
 */

import React, { useState } from 'react';
import { useTranslation } from 'react-i18next';
import './PhoneCarousel.css';

export interface CarouselScreen {
  emoji?: string;
  title: string;
  subtitle?: string;
  prompt?: string;
  response?: string;
  imageUrl?: string;
  backgroundColor?: string;
}

interface PhoneCarouselProps {
  screens: CarouselScreen[];
  personaColor: string;
}

export function PhoneCarousel({ screens, personaColor }: PhoneCarouselProps): React.ReactNode {
  // ✅ CORRECT: Hook called inside the component body, not at module level.
  const { t } = useTranslation('landing');
  const [currentIndex, setCurrentIndex] = useState(0);

  const goToPrevious = () => {
    setCurrentIndex((prev) => prev === 0 ? screens.length - 1 : prev - 1);
  };

  const goToNext = () => {
    setCurrentIndex((prev) => prev === screens.length - 1 ? 0 : prev + 1);
  };

  const currentScreen = screens[currentIndex];
 
  return (
    <div className="carousel-container">
      <div className="phone-mockup" style={{ backgroundColor: personaColor }}>
        <div className="phone-inner">
          <div className="phone-header">
            <span>📍</span>
            <span>9:41</span>
          </div>

          <div className="phone-content">
            {currentScreen.imageUrl ? (
              <div
                className="carousel-image"
                style={{
                  backgroundImage: `url(${currentScreen.imageUrl})`,
                  backgroundColor: currentScreen.backgroundColor || '#eaf2ec',
                }}
              >
                {currentScreen.emoji && (
                  <div className="carousel-emoji">{currentScreen.emoji}</div>
                )}
              </div>
            ) : (
              <div
                className="carousel-placeholder"
                style={{ backgroundColor: currentScreen.backgroundColor || '#eaf2ec' }}
              >
                {currentScreen.emoji && (
                  <div className="placeholder-emoji">{currentScreen.emoji}</div>
                )}
                <div className="placeholder-text">{currentScreen.title}</div>
              </div>
            )}

            <div className="carousel-text">
              <h3 className="carousel-title">{currentScreen.title}</h3>
              {currentScreen.subtitle && (
                <p className="carousel-subtitle">{currentScreen.subtitle}</p>
              )}

              {currentScreen.prompt && (
                <div className="carousel-prompt">
                  <div className="prompt-label">
                    {t('phonecarousel.prompt', '💬 Prompt')}
                  </div>
                  <p className="prompt-text">{currentScreen.prompt}</p>
                </div>
              )}

              {currentScreen.response && (
                <div className="carousel-response">
                  <div className="response-label">
                    {t('phonecarousel.response', '✓ Response')}
                  </div>
                  <p className="response-text">{currentScreen.response}</p>
                </div>
              )}
            </div>
          </div>

          <div className="phone-indicators">
            {screens.map((_, index) => (
              <div
                key={index}
                className={`indicator ${index === currentIndex ? 'active' : ''}`}
                onClick={() => setCurrentIndex(index)}
              />
            ))}
          </div>
        </div>
      </div>

      <div className="carousel-controls">
        <button className="carousel-btn" onClick={goToPrevious}>
          {t('phonecarousel.previous', '← Previous')}
        </button>
        <span className="carousel-counter">
          {currentIndex + 1} / {screens.length}
        </span>
        <button className="carousel-btn" onClick={goToNext}>
          {t('phonecarousel.next', 'Next →')}
        </button>
      </div>
    </div>
  );
}
</file>

