  // Actions
  fetchCaptures: (sessionId: string, filters?: Partial<CaptureFilters>) => Promise<void>;
  fetchCapture: (id: string) => Promise<void>;
  createCapture: (sessionId: string, data: CaptureFormData) => Promise<Capture>;
