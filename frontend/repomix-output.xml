    },
    parent: {
      headline: t('parent.headline'),
      intro: t('parent.intro'),
      cta: t('parent.cta'),
      secondary_cta: t('parent.secondary_cta'),
      image: '👨‍👩‍👧‍👦'
    }
  };

  const personaCarousels = {
