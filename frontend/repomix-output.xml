  font-weight: 700;
  line-height: 1.3;
  color: var(--text);
}

h4, .h4 {
  font-family: var(--font-head);
  font-size: var(--font-size-xl);
  font-weight: 600;
  line-height: 1.3;
  color: var(--text);
}

h5, .h5 {
  font-family: var(--font-head);
  font-size: var(--font-size-lg);
  font-weight: 600;
  line-height: 1.4;
  color: var(--text);
}

h6, .h6 {
  font-family: var(--font-head);
  font-size: var(--font-size-base);
  font-weight: 600;
  line-height: 1.5;
  color: var(--text);
}

p {
  margin-bottom: var(--space-md);
}

.text-base {
  font-size: var(--font-size-base);
  color: var(--text);
}

.text-sm {
  font-size: var(--font-size-sm);
  color: var(--text);
}

.text-xs {
  font-size: var(--font-size-xs);
  color: var(--text);
}

.text-lg {
  font-size: var(--font-size-lg);
  color: var(--text);
}

.text-muted {
  color: var(--text-muted);
}

.text-faint {
  color: var(--text-faint);
}

.text-primary {
  color: var(--primary);
}

.text-secondary {
  color: var(--secondary);
}

.text-success {
  color: var(--success);
}

.text-warn {
  color: var(--warn);
}

.text-error {
  color: var(--error);
}

.text-info {
