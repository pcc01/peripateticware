/* PORTFOLIO SECTION */
.sihw-portfolio {
  padding: 96px 40px;
  background-color: var(--bg);
}

.sihw-portfolio-features {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
  margin-top: 48px;
}

.sihw-portfolio-item {
  background-color: white;
  padding: 24px;
  border-radius: 16px;
  border: 1px solid var(--border);
  text-align: center;
}

.sihw-portfolio-icon {
  font-size: 40px;
  margin-bottom: 12px;
}

.sihw-portfolio-item h3 {
  font-size: 16px;
  font-weight: 700;
  margin: 0 0 8px 0;
}

.sihw-portfolio-item p {
  font-size: 13px;
  color: var(--text-muted);
  margin: 0;
  line-height: 1.6;
}

/* CTA SECTION */
.sihw-cta {
  padding: 96px 40px;
  background-color: var(--surface-alt);
  text-align: center;
}

.sihw-cta h2 {
  font-size: 36px;
  font-weight: 700;
  margin: 0 0 12px 0;
}

.sihw-cta p {
  font-size: 18px;
  color: var(--text-muted);
  margin: 0 0 32px 0;
}

.sihw-btn-primary {
  padding: 12px 32px;
  background-color: var(--accent);
  color: white;
  border: none;
  border-radius: 12px;
  font-weight: 600;
  cursor: pointer;
  font-size: 14px;
  transition: all 0.2s;
}

.sihw-btn-primary:hover {
  background-color: var(--accent-deep);
}

/* FOOTER */
.sihw-footer {
  padding: 48px 40px;
  border-top: 1px solid var(--border);
  background-color: var(--surface-alt);
  text-align: center;
}

.sihw-footer p {
  font-size: 13px;
  color: var(--text-muted);
  margin: 0;
}

/* RESPONSIVE */
@media (max-width: 768px) {
  .sihw-feature-grid,
  .sihw-tools-grid,
  .sihw-portfolio-features {
    grid-template-columns: 1fr;
  }

  .sihw-ai-showcase {
    grid-template-columns: 1fr;
  }

  .sihw-headline {
    font-size: 32px;
  }

  .sihw-section-title {
    font-size: 24px;
  }
}
