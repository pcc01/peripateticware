      navigate('/login');
    }, 2000);

    return () => clearTimeout(timer);
  }, [navigate]);

  return (
    <div className="min-h-screen bg-gradient-to-br from-blue-600 via-blue-500 to-green-500 flex flex-col items-center justify-center">
      {/* Background pattern */}
      <div className="absolute inset-0 opacity-10">
