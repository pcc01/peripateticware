#!/usr/bin/env python3
import re
from pathlib import Path

SRC_DIR = Path(__file__).parent.parent / "src"

def final_hook_repair():
    print("🛠️ Running Quote-Agnostic Hook Architectural Repair...")
    
    file_targets = list(SRC_DIR.glob("**/*.tsx")) + list(SRC_DIR.glob("**/*.ts"))
    repaired_count = 0

    # Handles single quotes, double quotes, optional semicolons, trailing spaces, and line breaks
    bad_global_regex = re.compile(r"const\s+\{\s*t\s*\}\s*=\s*useTranslation\(\s*['\"]landing['\"]\s*\);?\s*[\r\n]*")
    
    # Target declaration styles: const Comp = () => {, export const Comp = -> {, function Comp() {
    component_entry_regex = re.compile(r"(\b(?:const|function)\s+[A-Za-z0-9_]+\s*(?:=\s*(?:\([^)]*\))?\s*=>\s*)?\{\s*)")

    for file_path in file_targets:
        if "node_modules" in file_path.parts or "public" in file_path.parts:
            continue
            
        with open(file_path, "r", encoding="utf-8") as f:
            content = f.read()

        if bad_global_regex.search(content):
            # 1. Strip out the bad global line completely
            clean_content = bad_global_regex.sub("", content)
            
            # 2. Safely verify that it isn't already inside the component body
            # We match the first hook entry point safely
            if "const { t } = useTranslation" not in clean_content:
                clean_content = component_entry_regex.sub(r"\1\n  const { t } = useTranslation('landing');\n", clean_content, count=1)
            
            with open(file_path, "w", encoding="utf-8") as f:
                f.write(clean_content)
                
            print(f"✨ Repaired layout definition for: src/{file_path.relative_to(SRC_DIR)}")
            repaired_count += 1

    print(f"\n🏁 Successfully cleaned and normalized {repaired_count} files.")

if __name__ == "__main__":
    final_hook_repair()
