    >
      {/* Background circle */}
      <circle cx="22" cy="22" r="20" fill={accentMuted} />

      {/* Perched crow silhouette — side profile */}
      <path
        d="M22,8
          C26,8 30,10 31,14
          C32,17 30,19 31,21
          C33,23 34,22 35,24
          C32,25 30,23 29,25
          C30,28 29,31 27,33
          C25,35 23,34 22,34
          C21,34 19,35 17,33
          C15,31 14,28 15,25
          C13,23 11,25 8,24
          C9,22 10,23 12,21
          C13,19 11,17 12,14
          C13,10 18,8 22,8Z"
        fill={accent}
      />

      {/* Beak */}
      <path d="M12,14 Q7,15 6,17 Q9,17 12,16Z" fill={accent} />

      {/* Eye */}
      <circle cx="16" cy="14" r="2" fill="white" opacity="0.9" />
      <circle cx="16" cy="14" r="1.1" fill={accentMuted} />

      {/* Tail fork */}
