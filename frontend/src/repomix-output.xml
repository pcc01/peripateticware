  }

  .grid-2,
  .grid-3,
  .grid-4 {
    grid-template-columns: 1fr;
  }

  .modal-content {
    width: 95%;
    padding: var(--space-xl);
  }
}

@media (max-width: 480px) {
  :root {
    --space-xl: 16px;
    --space-2xl: 24px;
    --space-3xl: 32px;
  }

  h1, .h1 {
    font-size: var(--font-size-2xl);
  }

  .card,
  .card-base {
    padding: var(--space-lg);
  }

  input,
  textarea,
  select,
  .form-control {
    padding: var(--space-md) var(--space-md);
  }

  .modal-footer {
    flex-direction: column;
  }

  .modal-footer .btn {
    width: 100%;
  }
}

/* ============================================================================
   ANIMATIONS
   ============================================================================ */

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes slideUp {
  from {
    transform: translateY(20px);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

@keyframes slideDown {
  from {
    transform: translateY(-20px);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

@keyframes slideIn {
  from {
    transform: translateX(-20px);
    opacity: 0;
  }
  to {
