// ─────────────────────────────────────────────────────────────────
// COMPREHENSIVE TOKEN GETTER
// ─────────────────────────────────────────────────────────────────

export interface Tokens {
  // Typography
  fontHead: string;
  fontBody: string;
  fontMono: string;
  textXs: string;
  textSm: string;
  textBase: string;
  textMd: string;
  textLg: string;
  textXl: string;
  text2xl: string;
  text3xl: string;
  text4xl: string;

  // Colors - Surfaces
  bg: string;
  sidebar: string;
  surface: string;
  surfaceAlt: string;
  overlay: string;

  // Colors - Borders
  border: string;
  borderStrong: string;

  // Colors - Text
  text: string;
  textMuted: string;
  textFaint: string;
  textInvert: string;

  // Colors - Status (semantic)
  success: string;
  successLight: string;
  warn: string;
  warnLight: string;
  info: string;
  infoLight: string;
  danger: string;
  dangerLight: string;

  // Colors - Role accent
  accent: string;
  accentLight: string;
  accentText: string;

  // Radius
  radiusXs: string;
  radiusSm: string;
  radius: string;
  radiusLg: string;
  radiusXl: string;

  // Spacing
  space1: string;
  space2: string;
  space3: string;
  space4: string;
  space5: string;
  space6: string;
  space8: string;
  space10: string;
  space12: string;
  space16: string;

  // Shadows
