 */
function getAuthToken(): string {
  const token = localStorage.getItem('auth_token');
  if (!token) {
    throw new Error('No auth token found');
  }
  return token;
}

/**
 * Set API base URL (for testing)
 */
export function setApiBaseUrl(url: string): void {
  Object.assign(module, {
    API_BASE_URL: url,
  });
}
