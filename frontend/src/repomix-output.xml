  line-height: 1.6;
}

/* ─────────────────────────────────────────────────────────────────────────── */
/* COMPLIANCE GRID */
/* ─────────────────────────────────────────────────────────────────────────── */

.compliance-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
