            </label>
            <p className={styles.helpText}>{t("landing:track_all_administrative_actions", "Track all administrative actions")}</p>
          </div>

          <div className={styles.settingGroup}>
            <label className={styles.checkboxLabel}>
              <input
                type="checkbox"
