        </div>
      </div>);

  }

  if (error || !currentActivity) {
    return (
      <div className="max-w-4xl mx-auto p-6">
        <div className="bg-red-50 border border-red-200 rounded-lg p-6 text-red-800">
          <p className="font-semibold">{t("landing:error", "Error")}</p>
