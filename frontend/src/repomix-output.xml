          {/* ================================================================ */}

          <Route path="/404" element={<NotFoundPage />} />
          <Route path="*" element={<NotFoundPage />} />
        </Routes>
      </div>
    </I18nextProvider>
  )
}

// Main App with Router
const AppWithRouter: React.FC = () => (
  <Router>
