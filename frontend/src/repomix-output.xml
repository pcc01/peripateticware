          </h3>
            <p style={{ color: d.textMuted }}>{t("landing:manage_activities_standards_and_resource", "Manage activities, standards, and resources.")}</p>
          </Card>
        }

        {activeTab === 'analytics' &&
        <Card d={d}>
            <h3
            style={{
              fontFamily: d.fontHead,
              fontSize: d.textLg,
              fontWeight: 700,
              color: d.text,
              marginBottom: d.space4
