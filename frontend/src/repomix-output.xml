/**
 * CORRECTED AppRouter.tsx
 * 
 * This is the CORRECTED version of AppRouter.tsx that replaces the placeholder
 * routes with actual page components that use the API services.
 * 
 * Replace the placeholder routes in the original AppRouter.tsx with these routes.
 */

import React from 'react';
import { BrowserRouter, Routes, Route, Navigate } from 'react-router-dom';
import { useAuthStore } from '../../stores/auth';

// Auth Screens
import { SplashScreen } from './SplashScreen';
import { LoginScreen } from './LoginScreen';
import { SignUpScreen } from './SignUpScreen';
import { Dashboard } from './Dashboard';
import { ProtectedRoute } from './ProtectedRoute';

// Role-Specific Dashboards
import { TeacherDashboard } from '../teacher/TeacherDashboard';
import { StudentDashboard } from '../student/StudentDashboard';
import { ParentDashboard } from '../parent/ParentDashboard';
import { AdminDashboard } from '../admin/AdminDashboard';
import { StudentSettingsPage } from '../student/StudentSettingsPage'
import { TeacherSettingsPage } from '../teacher/TeacherSettingsPage'
import { ParentSettingsPage } from '../parent/ParentSettingsPage'
import { AdminSettingsPage } from '../admin/AdminSettingsPage'

// TEACHER PAGES (uses TeacherService)
import { TeacherActivityListPage } from '../../pages/teacher/ActivityListPage';
import { TeacherActivityDetailPage } from '../../pages/teacher/ActivityDetailPage';
import { TeacherActivityCreatePage } from '../../pages/teacher/ActivityCreatePage';
import { TeacherSubmissionsPage } from '../../pages/teacher/SubmissionsPage';
import { TeacherStudentRosterPage } from '../../pages/teacher/StudentRosterPage';
import { TeacherAnalyticsPage } from '../../pages/teacher/AnalyticsPage';
import { TeacherLocationsPage } from '../../pages/teacher/LocationsPage';
import { TeacherCurriculumPage } from '../../pages/teacher/CurriculumPage';
import { TeacherSettingsPage } from '../../pages/teacher/SettingsPage';
import { EnhancedActivityBuilder } from '../components/teacher/EnhancedActivityBuilder';

// STUDENT PAGES (uses StudentService)
import { StudentActivityListPage } from '../../pages/student/ActivityListPage';
import { StudentActivityDetailPage } from '../../pages/student/ActivityDetailPage';
import { StudentProgressPage } from '../../pages/student/ProgressPage';
import { StudentEvidenceGalleryPage } from '../../pages/student/EvidenceGalleryPage';
import { StudentAchievementsPage } from '../../pages/student/AchievementsPage';
import { StudentMessagesPage } from '../../pages/student/MessagesPage';
import { StudentHelpPage } from '../../pages/student/HelpPage';
import { StudentSettingsPage } from '../../pages/student/SettingsPage';

// PARENT PAGES (uses ParentService)
import { ParentProgressPage } from '../../pages/parent/ProgressPage';
import { ParentMessagesPage } from '../../pages/parent/MessagesPage';
import { ParentReportsPage } from '../../pages/parent/ReportsPage';
import { ParentCalendarPage } from '../../pages/parent/CalendarPage';
import { ParentNotificationsPage } from '../../pages/parent/NotificationsPage';
import { ParentHelpPage } from '../../pages/parent/HelpPage';
import { ParentSettingsPage } from '../../pages/parent/SettingsPage';

// ADMIN PAGES (uses AdminService)
import { AdminUserManagementPage } from '../../pages/admin/UserManagementPage';
import { AdminClassesPage } from '../../pages/admin/ClassesPage';
import { AdminSystemHealthPage } from '../../pages/admin/SystemHealthPage';
import { AdminPrivacyConfigPage } from '../../pages/admin/PrivacyConfigPage';
import { AdminAuditLogsPage } from '../../pages/admin/AuditLogsPage';
import { AdminAnalyticsPage } from '../../pages/admin/AnalyticsPage';
import { AdminSettingsPage } from '../../pages/admin/SettingsPage';
import { AdminHelpPage } from '../../pages/admin/HelpPage';

// Error Pages
const UnauthorizedPage = () => (
  <div className="min-h-screen bg-white flex items-center justify-center">
    <div className="text-center">
      <h1 className="text-4xl font-bold text-gray-900 mb-4">403</h1>
      <p className="text-gray-600 mb-8">You do not have permission to access this page.</p>
      <a href="/" className="text-green-700 hover:text-blue-700">
        Go back home
      </a>
    </div>
  </div>
);

const NotFoundPage = () => (
  <div className="min-h-screen bg-white flex items-center justify-center">
    <div className="text-center">
      <h1 className="text-4xl font-bold text-gray-900 mb-4">404</h1>
      <p className="text-gray-600 mb-8">Page not found.</p>
      <a href="/" className="text-green-700 hover:text-blue-700">
        Go back home
      </a>
    </div>
  </div>
);

/**
 * Main App Router - CORRECTED VERSION
 * 
 * All placeholder routes have been replaced with actual page components
 * that import and use the appropriate API services.
 */
export const AppRouter: React.FC = () => {
  const { isAuthenticated } = useAuthStore();

  return (
    <BrowserRouter>
      <Routes>
        {/* ============================================
            PUBLIC ROUTES
            ============================================ */}
        <Route 
          path="/" 
          element={isAuthenticated ? <Navigate to="/dashboard" replace /> : <SplashScreen />} 
        />
        <Route 
          path="/login" 
          element={isAuthenticated ? <Navigate to="/dashboard" replace /> : <LoginScreen />} 
        />
        <Route 
          path="/signup" 
          element={isAuthenticated ? <Navigate to="/dashboard" replace /> : <SignUpScreen />} 
        />

        {/* ============================================
            ERROR PAGES
            ============================================ */}
        <Route path="/unauthorized" element={<UnauthorizedPage />} />
        <Route path="*" element={<NotFoundPage />} />

        {/* ============================================
            AUTHENTICATION REDIRECT
            ============================================ */}
        <Route
          path="/dashboard"
          element={
