// ============================================================================
// FORGOT PASSWORD
// ============================================================================
export async function forgotPassword(payload: ForgotPasswordPayload): Promise<{ message: string }> {
  const response = await fetch(`${API_BASE_URL}/auth/forgot-password`, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
