# ─────────────────────────────────────────────────────────────────
# Peripateticware Dashboard — Environment Configuration
# ─────────────────────────────────────────────────────────────────
# Copy this file to .env.local and configure for your environment

# ─────────────────────────────────────────────────────────────────
# FRONTEND
# ─────────────────────────────────────────────────────────────────

# Dashboard UI mode (development/production)
VITE_ENV=development

# API endpoint configuration
# When running with Docker: http://localhost:8000
# When running locally: http://localhost:8000
VITE_API_URL=http://localhost:8000

# ─────────────────────────────────────────────────────────────────
# LLM CONFIGURATION (Ollama or Claude API)
# ─────────────────────────────────────────────────────────────────
# This is configured in the backend, but frontend can reference it

# LLM Provider: ollama or claude
VITE_LLM_PROVIDER=ollama

# Ollama configuration (runs on Windows host via host.docker.internal)
# When using Docker on Windows: http://host.docker.internal:11434
# When using directly: http://localhost:11434
VITE_OLLAMA_BASE_URL=http://localhost:11434

# Claude API key (only if using claude provider)
# Get your key from: https://console.anthropic.com/
# VITE_CLAUDE_API_KEY=sk-ant-...

# ─────────────────────────────────────────────────────────────────
# AUTHENTICATION
# ─────────────────────────────────────────────────────────────────

# JWT token storage location (localStorage or sessionStorage)
VITE_TOKEN_STORAGE=localStorage

# Default user role for testing (student | teacher | parent | admin)
VITE_DEFAULT_ROLE=student

# ─────────────────────────────────────────────────────────────────
# DESIGN SYSTEM
# ─────────────────────────────────────────────────────────────────

# Default visual direction (fieldguide | terrain | atmosphere)
VITE_DEFAULT_DIRECTION=fieldguide

# Enable theme switcher in UI
VITE_ENABLE_THEME_SWITCHER=true

# ─────────────────────────────────────────────────────────────────
# FEATURES
# ─────────────────────────────────────────────────────────────────

# Enable offline mode
VITE_ENABLE_OFFLINE=true

# Enable PWA (Progressive Web App)
VITE_ENABLE_PWA=false

# ─────────────────────────────────────────────────────────────────
# LOGGING & DEBUGGING
# ─────────────────────────────────────────────────────────────────

# Enable console logging (development only)
VITE_DEBUG=true

# API request timeout (milliseconds)
VITE_API_TIMEOUT=30000
