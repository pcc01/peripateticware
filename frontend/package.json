{
  "name": "peripateticware",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Peripateticware - Teacher-judgment-first outdoor learning platform",
  "author": "Paul Cerda",
  "license": "BSL-1.1",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "linters": "eslint src --ext ts,tsx",
    "format": "prettier --write src/",
    "i18n:tag": "node scripts/ast_tagger.cjs",
    "i18n:extract": "npx i18next-parser --config i18next-parser.config.cjs",
    "i18n:fix-logs": "python scripts/fix_i18n_conflicts.py",
    "i18n:repair:check": "python scripts/repair_locale_json.py --check",
    "i18n:repair": "python scripts/repair_locale_json.py",
    "i18n:validate": "node scripts/validate_locales.cjs",
    "i18n:sync": "python scripts/translate_sync.py --non-interactive --provider OLLAMA",
    "i18n:sync:ci": "python scripts/translate_sync.py --non-interactive --provider MICROSOFT",
    "i18n:qa": "python scripts/localization_qa_crawler.py",
    "i18n:retranslate": "python scripts/retranslate_flagged.py",
    "i18n:review-pipeline": "npx run-s i18n:qa i18n:retranslate i18n:qa",
    "i18n:review": "python scripts/review_pipeline.py",
    "i18n:prepare": "npx run-s i18n:tag i18n:extract",
    "i18n:run-all": "npx run-s i18n:repair:check i18n:tag i18n:extract i18n:sync",
    "i18n:run-all:ci": "npx run-s i18n:repair:check i18n:tag i18n:extract i18n:sync:ci",
    "build": "npm run i18n:run-all && tsc -b && vite build",
    "build:no-i18n": "tsc -b && vite build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed --project=chromium",
    "test:e2e:report": "playwright show-report playwright-report",
    "test:e2e:teacher": "playwright test tests/e2e/teacher-flows.spec.ts",
    "test:e2e:student": "playwright test tests/e2e/student-flows.spec.ts",
    "test:e2e:admin": "playwright test tests/e2e/admin-flows.spec.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.4.0",
    "@internationalized/date": "^3.12.2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "axios": "^1.7.7",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "i18next": "^23.7.13",
    "i18next-browser-languagedetector": "^7.2.1",
    "i18next-http-backend": "^2.4.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.408.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.52.2",
    "react-i18next": "^15.0.0",
    "react-router-dom": "^6.28.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.49.0",
    "@types/leaflet": "^1.9.8",
    "@types/node": "^20.14.11",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.10.2",
    "eslint": "^8.57.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.48",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
